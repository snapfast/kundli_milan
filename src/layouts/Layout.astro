---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style is:global>
			/* Base Styles */
			body {
				font-family: sans-serif;
				max-width: 800px;
				margin: 2rem auto;
				padding: 0 1rem;
				line-height: 1.6;
				background-color: #f4f7f6;
			}
			.container {
				background: white;
				padding: 2rem;
				border-radius: 12px;
				box-shadow: 0 4px 20px rgba(0,0,0,0.08);
			}
			h1, h2 {
				color: #2c3e50;
				border-bottom: 2px solid #6c5ce7;
				padding-bottom: 0.5rem;
			}

			/* Form & Buttons */
			form {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				background: white;
				padding: 1.5rem;
				border-radius: 8px;
				border: 1px solid #e1e4e8;
			}
			.field {
				display: flex;
				flex-direction: column;
				position: relative;
			}
			label {
				font-weight: bold;
				margin-bottom: 0.25rem;
				color: #333;
			}
			input, select {
				padding: 0.5rem;
				border: 1px solid #ccc;
				border-radius: 4px;
			}
			button, .btn {
				padding: 0.75rem 1.5rem;
				background-color: #6c5ce7;
				color: white;
				border: none;
				border-radius: 6px;
				cursor: pointer;
				font-size: 1rem;
				text-decoration: none;
				display: inline-block;
				text-align: center;
			}
			button:hover, .btn:hover {
				background-color: #5b4bc4;
			}
			.btn-danger {
				background-color: #dc3545;
			}
			.btn-danger:hover {
				background-color: #c82333;
			}

			/* Match Card Styles (Global) */
			.matches-section {
				margin-top: 2rem;
			}
			.match-card {
				background: #fff;
				border: 1px solid #e1e4e8;
				border-radius: 12px;
				padding: 1.5rem;
				margin-bottom: 1rem;
				transition: transform 0.2s;
				box-shadow: 0 4px 6px rgba(0,0,0,0.05);
			}
			.match-card:hover {
				transform: translateY(-5px);
			}
			.match-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.5rem;
			}
			.match-name {
				font-size: 1.25rem;
				font-weight: bold;
				color: #2c3e50;
			}
			.match-category {
				background: #6c5ce7;
				color: white;
				padding: 0.25rem 0.75rem;
				border-radius: 20px;
				font-size: 0.8rem;
				font-weight: bold;
			}
			.match-score {
				font-size: 1.5rem;
				font-weight: bold;
				color: #00b894;
			}
			.match-description {
				font-style: italic;
				color: #636e72;
				font-size: 0.95rem;
			}
			.koota-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
				gap: 0.5rem;
				margin-top: 1rem;
			}
			.koota-item {
				font-size: 0.8rem;
				color: #2d3436;
				background: #f1f2f6;
				padding: 0.4rem;
				border-radius: 4px;
				text-align: center;
				cursor: help;
				position: relative;
			}
			.koota-item:hover .koota-explanation {
				display: block;
			}
			.koota-explanation {
				display: none;
				position: absolute;
				bottom: 100%;
				left: 50%;
				transform: translateX(-50%);
				background: #333;
				color: white;
				padding: 0.5rem;
				border-radius: 4px;
				width: 200px;
				z-index: 10;
				font-size: 0.75rem;
				text-align: left;
				box-shadow: 0 2px 5px rgba(0,0,0,0.2);
			}
		</style>
	</head>
	<body>
		<nav style="margin-bottom: 2rem; display: flex; gap: 1rem;">
			<a href="/" class="btn">Home</a>
			<a href="/dashboard" class="btn" id="dashboardLink">Dashboard</a>
		</nav>

		<div class="container">
			<slot />
		</div>
	</body>
</html>