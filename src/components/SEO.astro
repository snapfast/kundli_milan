---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title = "moonine - A Vedic Matchmaker | Accurate Vedic Astrology & Guna Milan",
  description = "Find compatible life partners with moonine - A Vedic Matchmaker. High-precision 36-point Ashta Koota Guna Milan, Nakshatra alignment, and Manglik Dosha analysis.",
  image = "/og-image.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url.origin).href,
  type = "website",
  noindex = false,
} = Astro.props;

const siteName = "moonine - A Vedic Matchmaker";
const fullImageUrl = new URL(image, Astro.url.origin).href;
const imageAlt = "moonine - A Vedic Matchmaker - Vedic Astrology Matchmaking & Free Guna Milan";
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content={siteName} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={fullImageUrl} />
<meta property="twitter:image:alt" content={imageAlt} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.url.origin}/#website`,
      "url": Astro.url.origin,
      "name": "moonine - A Vedic Matchmaker",
      "alternateName": ["moonine", "moonine Vedic Matchmaker"],
      "description": description,
      "inLanguage": "en"
    },
    {
      "@type": "Organization",
      "@id": `${Astro.url.origin}/#organization`,
      "name": "moonine",
      "url": Astro.url.origin,
      "logo": new URL("/favicon.png", Astro.url.origin).href,
      "sameAs": [
        "https://moonine.netlify.app"
      ]
    },
    {
      "@type": "WebApplication",
      "@id": `${Astro.url.origin}/#webapp`,
      "name": siteName,
      "alternateName": "moonine",
      "description": description,
      "url": Astro.url.origin,
      "applicationCategory": "AstrologyApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "inLanguage": "en",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "author": {
        "@id": `${Astro.url.origin}/#organization`
      }
    }
  ]
})} />

<!-- Additional SEO Meta Tags -->
{noindex ? (
  <>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <meta name="bingbot" content="noindex, nofollow" />
  </>
) : (
  <>
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />
  </>
)}
<meta name="theme-color" content="#ffcb37" />
<meta name="keywords" content="vedic astrology, matchmaking, guna milan, ashta koota, kundli milan, astrology compatibility, zodiac signs, nakshatra, manglik dosha, free kundali matching, horoscope matching for marriage, find life partner, vedic matchmaker, kundli matching, guna milan online, marriage compatibility, moonine" />
