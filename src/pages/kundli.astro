---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Your Kundli">
	<style>
		.details-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			gap: 1rem;
			margin-bottom: 2rem;
		}
		.detail-item {
			background: #eee;
			padding: 1rem;
			border-radius: 4px;
		}
		.detail-label {
			font-weight: bold;
			display: block;
			font-size: 0.9rem;
			color: #666;
		}
		.detail-value {
			font-size: 1.1rem;
			color: #000;
		}
		table {
			width: 100%;
			border-collapse: collapse;
			margin-top: 1rem;
		}
		th, td {
			text-align: left;
			padding: 0.75rem;
			border-bottom: 1px solid #ddd;
		}
		th {
			background-color: #f2f2f2;
		}
		.matchmaking-notice {
			margin-top: 2rem;
			padding: 1rem;
			background-color: #f4f0ff;
			border-left: 5px solid #6c5ce7;
			border-radius: 4px;
		}
	</style>

	<h1>Your Astrology Details</h1>

			<div id="loading">Calculating your Kundli...</div>

			<div id="results" style="display: none;">
				<div class="details-grid">
					<div class="detail-item">
						<span class="detail-label">Name</span>
						<span class="detail-value" id="res-name"></span>
					</div>
					<div class="detail-item">
						<span class="detail-label">DOB</span>
						<span class="detail-value" id="res-dob"></span>
					</div>
					<div class="detail-item">
						<span class="detail-label">Time</span>
						<span class="detail-value" id="res-tob"></span>
					</div>
					<div class="detail-item">
						<span class="detail-label">Gender</span>
						<span class="detail-value" id="res-gender"></span>
					</div>
					<div class="detail-item">
						<span class="detail-label">Location</span>
						<span class="detail-value" id="res-location"></span>
					</div>
				</div>

				<h2>Panchang</h2>
				<div class="details-grid">
					<div class="detail-item"><span class="detail-label">Tithi</span><span class="detail-value" id="p-tithi"></span></div>
					<div class="detail-item"><span class="detail-label">Nakshatra</span><span class="detail-value" id="p-nak"></span></div>
					<div class="detail-item"><span class="detail-label">Yoga</span><span class="detail-value" id="p-yoga"></span></div>
					<div class="detail-item"><span class="detail-label">Karana</span><span class="detail-value" id="p-karana"></span></div>
					<div class="detail-item"><span class="detail-label">Vara</span><span class="detail-value" id="p-vara"></span></div>
					<div class="detail-item"><span class="detail-label">Sunrise</span><span class="detail-value" id="p-sunrise"></span></div>
				</div>

				<h2>Planetary Positions</h2>
				<table id="planets-table">
					<thead>
						<tr>
							<th>Planet</th>
							<th>Rasi (Sign)</th>
							<th>Degree</th>
							<th>House</th>
						</tr>
					</thead>
					<tbody>
					</tbody>
				</table>

				<div id="matches" class="matches-section" style="display: none;">
					<h2>Your Top 3 Cosmic Matches</h2>
					<div id="matches-list"></div>
				</div>

				<div class="matchmaking-notice" id="matching-status">
					<strong>Matchmaking System:</strong> Calculating your cosmic matches and saving your profile...
				</div>

				<a href="/dashboard" class="btn" style="display:inline-block; margin-top: 1.5rem;">View My Dashboard</a>
			</div>

	<script>
			import { calculateAstrology } from '../lib/astrology';
			import { calculateCompatibility } from '../lib/compatibility';
			import { fetchUsers, saveUserProfile } from '../lib/api';
			import { KOOTA_INFO } from '../lib/constants';
			import { getCookie } from '../lib/user';
			import { generateMatchCardHtml } from '../lib/ui';

			window.addEventListener('load', async () => {
				const stored = getCookie('user_details');
				if (!stored) {
					window.location.href = '/';
					return;
				}

				const details = JSON.parse(stored);
				document.getElementById('res-name')!.textContent = details.name;
				document.getElementById('res-dob')!.textContent = details.dob;
				document.getElementById('res-tob')!.textContent = details.tob;
				document.getElementById('res-gender')!.textContent = details.gender;
				document.getElementById('res-location')!.textContent = details.location;

				try {
					const lat = details.lat ? parseFloat(details.lat) : 28.6139;
					const lon = details.lon ? parseFloat(details.lon) : 77.2090;

					const data = calculateAstrology(details.dob, details.tob, lat, lon);

					const currentUserAstrology = {
						name: details.name,
						nakshatraIdx: data.panchang.nakshatraIdx,
						moonSignIdx: data.panchang.moonSignIdx,
						isManglik: data.panchang.isManglik
					};

					document.getElementById('p-tithi')!.textContent = data.panchang.tithi;
					document.getElementById('p-nak')!.textContent = data.panchang.nakshatra;
					document.getElementById('p-yoga')!.textContent = data.panchang.yoga;
					document.getElementById('p-karana')!.textContent = data.panchang.karana;
					document.getElementById('p-vara')!.textContent = data.panchang.vara;
					document.getElementById('p-sunrise')!.textContent = data.panchang.sunrise;

					const tbody = document.querySelector('#planets-table tbody')!;
					data.planets.forEach(p => {
						const tr = document.createElement('tr');
						tr.innerHTML = `
							<td>${p.name}</td>
							<td>${p.rasi}</td>
							<td>${p.degree}</td>
							<td>${p.house}</td>
						`;
						tbody.appendChild(tr);
					});

					document.getElementById('loading')!.style.display = 'none';
					document.getElementById('results')!.style.display = 'block';

					const otherUsers = await fetchUsers();
					const filteredUsers = otherUsers.filter(u => u.userId !== details.userId);

					const resultsWithScores = filteredUsers.map(user => {
						let uNakIdx = user.nakshatraIdx;
						let uMoonSignIdx = user.moonSignIdx;
						let uIsManglik = user.isManglik;

						if (uNakIdx === undefined || uMoonSignIdx === undefined || uIsManglik === undefined) {
							const uData = calculateAstrology(user.dob, user.tob);
							uNakIdx = uData.panchang.nakshatraIdx;
							uMoonSignIdx = uData.panchang.moonSignIdx;
							uIsManglik = uData.panchang.isManglik;
						}

						const compat = calculateCompatibility(currentUserAstrology, {
							name: user.name,
							nakshatraIdx: uNakIdx,
							moonSignIdx: uMoonSignIdx,
							isManglik: uIsManglik
						});

						return { user, compat };
					});

					resultsWithScores.sort((a, b) => b.compat.score - a.compat.score);
					const top3 = resultsWithScores.slice(0, 3);

					await saveUserProfile({
						...details,
						nakshatraIdx: data.panchang.nakshatraIdx,
						moonSignIdx: data.panchang.moonSignIdx,
						isManglik: data.panchang.isManglik,
						matches: top3.map(m => ({
							name: m.user.name,
							score: m.compat.score,
							category: m.compat.category
						}))
					});

					document.getElementById('matching-status')!.innerHTML = `<strong>Matchmaking Complete!</strong> Your profile has been updated with your top matches.`;

					if (top3.length > 0) {
						const matchesList = document.getElementById('matches-list')!;
						top3.forEach(m => {
							const kootaHtml = `
								<div class="koota-grid">
									${m.compat.kootas.map(k => `
										<div class="koota-item">
											${k.name}: ${k.score}/${k.max}
											<div class="koota-explanation">${KOOTA_INFO[k.name] || ""}</div>
										</div>
									`).join('')}
								</div>
							`;

							const card = document.createElement('div');
							card.className = 'match-card';
							card.innerHTML = generateMatchCardHtml(
								m.user.name,
								m.compat.category,
								m.compat.score,
								m.compat.description,
								kootaHtml
							);
							matchesList.appendChild(card);
						});
						document.getElementById('matches')!.style.display = 'block';
					} else {
						document.getElementById('matches-list')!.innerHTML = '<p>No other users found yet to match with. Check back later!</p>';
						document.getElementById('matches')!.style.display = 'block';
					}

				} catch (e) {
					console.error(e);
					document.getElementById('loading')!.textContent = 'Error calculating Kundli. Please check your input.';
				}
			});
	</script>
</Layout>
