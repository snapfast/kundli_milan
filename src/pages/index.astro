---
import Layout from '../layouts/Layout.astro';
---

<Layout title="moonine - Astrology Matchmaker">
	<style>
		#suggestions {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: white;
			border: 1px solid #ccc;
			border-top: none;
			z-index: 1000;
			max-height: 200px;
			overflow-y: auto;
			display: none;
			border-radius: 0 0 4px 4px;
			box-shadow: 0 4px 6px rgba(0,0,0,0.1);
		}
		.suggestion-item {
			padding: 0.75rem;
			cursor: pointer;
			border-bottom: 1px solid #eee;
		}
		.suggestion-item:last-child {
			border-bottom: none;
		}
		footer {
			margin-top: 2rem;
			font-size: 0.75rem;
			color: #6c757d;
			text-align: center;
		}
		.form-actions {
			display: flex;
			gap: 0.75rem;
			margin-top: 0.5rem;
		}
		.btn-submit {
			flex: 2;
		}
		.btn-reset {
			flex: 1;
		}
		.visual-guide h2, .visual-guide h3 {
			border-bottom: none;
			text-align: center;
			margin-top: 1rem;
		}
		.info-card {
			background: #fff;
			border: 1px solid #e2e8f0;
			padding: 0.5rem 0.75rem;
			border-radius: 6px;
			text-align: center;
		}
		.info-label {
			font-weight: 700;
			font-size: 0.75rem;
			text-transform: uppercase;
			color: #6366f1;
			margin-bottom: 0.25rem;
		}
		.compact-table {
			width: 100%;
			border-collapse: collapse;
			font-size: 0.8rem;
		}
		.compact-table th, .compact-table td {
			padding: 0.35rem 0.5rem;
			text-align: left;
			border-bottom: 1px solid #f1f5f9;
		}
		.compact-table th {
			background-color: #f8fafc;
			color: #475569;
			font-weight: 700;
		}
	</style>

	<div style="background: #eff6ff; border: 1px solid #bfdbfe; padding: 0.4rem; border-radius: 4px; text-align: center; margin-bottom: 1rem; font-size: 0.75rem; font-weight: 600; color: #1e40af;">
		🎁 Limited Offer: Free for the first 100 users!
	</div>

	<h1>Submit Your Details</h1>
		<div id="redirecting" style="display: none; text-align: center; padding: 2rem;">
			Redirecting to your dashboard...
		</div>

		<form id="detailsForm" novalidate>
			<div class="form-row">
				<div class="field">
					<label for="name">Full Name</label>
					<input type="text" id="name" name="name" required minlength="2" maxlength="50" placeholder="Enter your full name" />
				</div>
				<div class="field">
					<label for="email">Email Address</label>
					<input type="email" id="email" name="email" required placeholder="your.email@example.com" />
				</div>
			</div>
			<div class="form-row">
				<div class="field">
					<label for="dob">Date of Birth</label>
					<input type="date" id="dob" name="dob" required max={new Date().toISOString().split('T')[0]} />
				</div>
				<div class="field">
					<label for="tob">Time of Birth</label>
					<div style="display: flex; gap: 0.25rem;">
						<select id="tob_hour" required style="flex: 1;">
							<option value="">Hour</option>
						</select>
						<select id="tob_min" required style="flex: 1;">
							<option value="">Min</option>
						</select>
						<select id="tob_ampm" required style="flex: 1;">
							<option value="AM">AM</option>
							<option value="PM">PM</option>
						</select>
					</div>
					<input type="hidden" id="tob" name="tob" />
				</div>
			</div>
			<div class="form-row">
				<div class="field">
					<label for="gender">Gender</label>
					<select id="gender" name="gender" required>
						<option value="">Select Gender</option>
						<option value="male">Male</option>
						<option value="female">Female</option>
						<option value="other">Other</option>
					</select>
				</div>
				<div class="field">
					<label for="location">Location (City, Country)</label>
					<input type="text" id="location" name="location" required placeholder="e.g. New Delhi, India" autocomplete="off" />
					<div id="suggestions"></div>
					<input type="hidden" id="lat" name="lat" />
					<input type="hidden" id="lon" name="lon" />
				</div>
			</div>
			<div class="form-actions">
				<button type="submit" class="btn-submit">Submit Details</button>
				<button type="button" id="resetBtn" class="btn-reset btn-danger">Reset</button>
			</div>
		</form>

	<section class="visual-guide" style="margin-top: 2rem; border-top: 1px solid #e2e8f0; padding-top: 1.5rem;">
		<h2>Ancient Wisdom. Modern Match.</h2>

		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
			<div class="info-card">
				<div class="info-label">Guna Milan</div>
				<div class="info-value" style="font-size: 0.8rem;">36-point traditional Ashta Koota system for deep soul compatibility.</div>
			</div>
			<div class="info-card">
				<div class="info-label">Dosha Analysis</div>
				<div class="info-value" style="font-size: 0.8rem;">Smart detection of Manglik and Gana doshas with traditional cancellation rules.</div>
			</div>
			<div class="info-card">
				<div class="info-label">High Precision</div>
				<div class="info-value" style="font-size: 0.8rem;">Calculations powered by high-precision astronomical algorithms (Lahiri Ayanamsa).</div>
			</div>
		</div>

		<h3>The 8 Pillars of Compatibility</h3>
		<div style="overflow-x: auto;">
			<table class="compact-table">
				<thead>
					<tr>
						<th>Koota</th>
						<th>Focus Area</th>
						<th>Max</th>
					</tr>
				</thead>
				<tbody>
					<tr><td>Varna</td><td>Spiritual & Ego alignment</td><td>1</td></tr>
					<tr><td>Vashya</td><td>Mutual attraction & Power balance</td><td>2</td></tr>
					<tr><td>Tara</td><td>Health, Destiny & Longevity</td><td>3</td></tr>
					<tr><td>Yoni</td><td>Biological & Intimate compatibility</td><td>4</td></tr>
					<tr><td>Maitri</td><td>Friendship & Psychological bond</td><td>5</td></tr>
					<tr><td>Gana</td><td>Temperament & Character matching</td><td>6</td></tr>
					<tr><td>Bhakoot</td><td>Emotional & Financial prosperity</td><td>7</td></tr>
					<tr><td>Nadi</td><td>Genetic health & Progeny</td><td>8</td></tr>
				</tbody>
				<tfoot>
					<tr>
						<th colspan="2" style="text-align: right;">Total Potential</th>
						<th>36</th>
					</tr>
				</tfoot>
			</table>
		</div>

		<p style="text-align: center; margin-top: 1.5rem;">
			<a href="/astrology-guide" class="btn">Visual Astrology Guide &rarr;</a>
		</p>
	</section>

	<script>
			import { getOrSetUserId, getCookie, setCookie, clearUserData } from '../lib/user';
			import { fetchUsers, resetUserProfile } from '../lib/api';

			// Immediate redirection if user details already exist
			const urlParams = new URLSearchParams(window.location.search);
			const isEditMode = urlParams.get('edit') === 'true';
			const storedDetails = getCookie('user_details');

			if (storedDetails && !isEditMode) {
				window.location.href = '/dashboard';
			}

			const form = document.getElementById('detailsForm') as HTMLFormElement;
			const nameInput = document.getElementById('name') as HTMLInputElement;
			const emailInput = document.getElementById('email') as HTMLInputElement;
			const dobInput = document.getElementById('dob') as HTMLInputElement;
			const genderInput = document.getElementById('gender') as HTMLSelectElement;
			const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement;
			const locationInput = document.getElementById('location') as HTMLInputElement;
			const suggestionsContainer = document.getElementById('suggestions') as HTMLDivElement;
			const latInput = document.getElementById('lat') as HTMLInputElement;
			const lonInput = document.getElementById('lon') as HTMLInputElement;
			const redirectingDiv = document.getElementById('redirecting') as HTMLDivElement;

			const tobHour = document.getElementById('tob_hour') as HTMLSelectElement;
			const tobMin = document.getElementById('tob_min') as HTMLSelectElement;
			const tobAmPm = document.getElementById('tob_ampm') as HTMLSelectElement;
			const tobHidden = document.getElementById('tob') as HTMLInputElement;

			// Populate Hour and Min dropdowns
			for (let i = 1; i <= 12; i++) {
				const val = i.toString().padStart(2, '0');
				const opt = new Option(val, val);
				tobHour.add(opt);
			}
			for (let i = 0; i < 60; i++) {
				const val = i.toString().padStart(2, '0');
				const opt = new Option(val, val);
				tobMin.add(opt);
			}

			function syncTime() {
				const h = tobHour.value;
				const m = tobMin.value;
				const ap = tobAmPm.value;
				if (h && m && ap) {
					let h24 = parseInt(h);
					if (ap === 'PM' && h24 < 12) h24 += 12;
					if (ap === 'AM' && h24 === 12) h24 = 0;
					tobHidden.value = `${h24.toString().padStart(2, '0')}:${m}`;
					autoSave();
				}
			}

			[tobHour, tobMin, tobAmPm].forEach(el => el.addEventListener('change', syncTime));

			// Ensure user ID is set on load
			const uid = getOrSetUserId();

			// Pre-fill form from cookies
			function preFillForm() {
				const stored = getCookie('user_details');
				if (stored) {
					try {
						const details = JSON.parse(stored);
						const fields = ['name', 'email', 'dob', 'tob', 'gender', 'location', 'lat', 'lon'];
						fields.forEach(field => {
							const element = document.getElementById(field) as HTMLInputElement | HTMLSelectElement;
							if (element && details[field]) {
								element.value = details[field];
							}
						});

						// Sync the AM/PM dropdowns
						if (details.tob) {
							const [h24, min] = details.tob.split(':');
							let h12 = parseInt(h24);
							const ampm = h12 >= 12 ? 'PM' : 'AM';
							h12 = h12 % 12;
							if (h12 === 0) h12 = 12;

							tobHour.value = h12.toString().padStart(2, '0');
							tobMin.value = min;
							tobAmPm.value = ampm;
						}
					} catch (e) {
						console.error('Error parsing user_details cookie:', e);
					}
				}
			}
			preFillForm();

			// Auto-save logic
			function autoSave() {
				const formData = new FormData(form);
				const data = Object.fromEntries(formData.entries());
				const payload = {
					...data,
					uid: getOrSetUserId()
				};
				setCookie('user_details', JSON.stringify(payload), 365);
			}

			form.addEventListener('input', autoSave);
			form.addEventListener('change', autoSave);

			// Check if user already exists and redirect to dashboard if so
			async function checkExistingUser() {
				const users = await fetchUsers();
				const existingUser = users.find(u => u.uid === uid);
				if (existingUser && existingUser.name) { // Ensure they actually have a profile
					form.style.display = 'none';
					redirectingDiv.style.display = 'block';

					// Hide the dashboard link since we are redirecting anyway
					const dashboardLink = document.getElementById('dashboardLink');
					if (dashboardLink) {
						dashboardLink.style.display = 'none';
					}

					window.location.href = '/dashboard';
				}
			}
			checkExistingUser();

			resetBtn?.addEventListener('click', async () => {
				if (confirm('Are you sure you want to reset your profile? Please note that we do not keep your data after a reset. It will be permanently deleted from our systems as well as your local device.')) {
					const uid = getOrSetUserId();
					if (uid) await resetUserProfile(uid);
					clearUserData();
					window.location.reload();
				}
			});

			// Location Autocomplete
			let timeout: ReturnType<typeof setTimeout>;
			locationInput?.addEventListener('input', () => {
				clearTimeout(timeout);
				const query = locationInput.value;
				if (query.length < 3) {
					suggestionsContainer.style.display = 'none';
					return;
				}

				timeout = setTimeout(async () => {
					try {
						suggestionsContainer.innerHTML = '<div class="suggestion-item" style="color: #666;">Searching locations...</div>';
						suggestionsContainer.style.display = 'block';

						const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=5`);

						if (!response.ok) throw new Error('Network response was not ok');

						const data = await response.json();

						suggestionsContainer.innerHTML = '';
						if (data.length > 0) {
							data.forEach((item: any) => {
								const div = document.createElement('div');
								div.className = 'suggestion-item';
								div.textContent = item.display_name;
								div.addEventListener('click', () => {
									locationInput.value = item.display_name;
									latInput.value = item.lat;
									lonInput.value = item.lon;
									suggestionsContainer.style.display = 'none';
									autoSave(); // Ensure lat/lon are saved
								});
								suggestionsContainer.appendChild(div);
							});
							suggestionsContainer.style.display = 'block';
						} else {
							suggestionsContainer.innerHTML = '<div class="suggestion-item" style="color: #dc3545;">No locations found. Try a different city.</div>';
							suggestionsContainer.style.display = 'block';
						}
					} catch (error) {
						console.error('Error fetching locations:', error);
						suggestionsContainer.innerHTML = '<div class="suggestion-item" style="color: #dc3545;">Error connecting to location service. Please type manually or try again.</div>';
						suggestionsContainer.style.display = 'block';
					}
				}, 300);
			});

			document.addEventListener('click', (e) => {
				if (e.target !== locationInput) {
					suggestionsContainer.style.display = 'none';
				}
			});

			form?.addEventListener('submit', async (e) => {
				e.preventDefault();

				if (!nameInput.value || nameInput.value.length < 2) {
					alert('Please enter your full name (at least 2 characters).');
					nameInput.focus();
					return;
				}

				const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
				if (!emailInput.value || !emailRegex.test(emailInput.value)) {
					alert('Please enter a valid email address.');
					emailInput.focus();
					return;
				}

				if (!dobInput.value) {
					alert('Please select your Date of Birth.');
					dobInput.focus();
					return;
				}

				// Manual validation for fields that might fail silently or need specific selection
				if (!tobHidden.value) {
					alert('Please select your complete Time of Birth.');
					tobHour.focus();
					return;
				}

				if (!genderInput.value) {
					alert('Please select your Gender.');
					genderInput.focus();
					return;
				}

				if (!locationInput.value) {
					alert('Please enter your birth location.');
					locationInput.focus();
					return;
				}

				if (!latInput.value || !lonInput.value) {
					alert('Please select a location from the suggestions list to get accurate coordinates.');
					locationInput.focus();
					return;
				}

				const formData = new FormData(form);
				const data = Object.fromEntries(formData.entries());
				const uid = getOrSetUserId();

				const payload = {
					...data,
					uid: uid
				};

				// Save to cookie immediately for dashboard use
				setCookie('user_details', JSON.stringify(payload), 365);

				// Show loading state on button
				const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
				submitBtn.disabled = true;
				submitBtn.textContent = 'Saving...';

				try {
					// We import saveUserProfile here or at the top
					const { saveUserProfile } = await import('../lib/api');
					const { calculateAstrology } = await import('../lib/astrology');

					const dataPayload = payload as any;

					// Calculate basic astrology for the user to store it
					const lat = dataPayload.lat ? parseFloat(dataPayload.lat as string) : 28.6139;
					const lon = dataPayload.lon ? parseFloat(dataPayload.lon as string) : 77.2090;
					const astroData = calculateAstrology(dataPayload.dob as string, dataPayload.tob as string, lat, lon);

					const profileToSave = {
						...payload,
						nakshatraIdx: astroData.panchang.nakshatraIdx,
						moonSignIdx: astroData.panchang.moonSignIdx,
						isMoonManglik: astroData.panchang.isMoonManglik,
						isLaganManglik: astroData.panchang.isLaganManglik,
						matches: [] // Will be populated by dashboard
					} as any;

					await saveUserProfile(profileToSave);
					window.location.href = '/dashboard';
				} catch (error) {
					console.error('Error saving profile:', error);
					// Even if save fails, we go to dashboard because we have local cookies
					window.location.href = '/dashboard';
				}
			});
	</script>
</Layout>
