---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title = "moonine - A Vedic Matchmaker",
  description = "moonine - A Vedic Matchmaker offers accurate Vedic Astrology matchmaking using the traditional Ashta Koota (36-point) system.",
  image = "/favicon.png",
  canonicalURL = Astro.url.href,
  type = "website",
  noindex = false,
} = Astro.props;

const siteName = "moonine - A Vedic Matchmaker";
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:site_name" content={siteName} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url.href} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": siteName,
  "alternateName": "moonine",
  "description": description,
  "url": Astro.url.origin,
  "applicationCategory": "AstrologyApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Organization",
    "name": "moonine - A Vedic Matchmaker Team",
    "url": Astro.url.origin
  }
})} />

<!-- Additional SEO Meta Tags -->
{noindex ? (
  <>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <meta name="bingbot" content="noindex, nofollow" />
  </>
) : (
  <>
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />
  </>
)}
<meta name="theme-color" content="#ffcb37" />
<meta name="keywords" content="vedic astrology, matchmaking, guna milan, ashta koota, kundli milan, astrology compatibility, zodiac signs, nakshatra, manglik dosha, free kundali matching, horoscope matching for marriage, find life partner, vedic matchmaker, kundli matching, guna milan online, marriage compatibility, moonine" />
