---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Log In - moonine">
	<style>
		.login-card {
			max-width: 440px;
			margin: 4rem auto;
			padding: 2.5rem 2rem;
			background: var(--bumble-charcoal);
			border: 2px solid var(--bumble-yellow);
			border-radius: 24px;
			box-shadow: 0 12px 32px rgba(0,0,0,0.25);
			color: white;
			position: relative;
		}
		/* Add slight honeycomb patterns */
		.login-card::before {
			content: "";
			position: absolute;
			top: 0; left: 0; right: 0; bottom: 0;
			opacity: 0.05;
			background-image:
				radial-gradient(circle, var(--bumble-yellow) 2px, transparent 3px),
				radial-gradient(circle, var(--bumble-yellow) 2px, transparent 3px);
			background-size: 20px 20px;
			background-position: 0 0, 10px 10px;
			pointer-events: none;
			border-radius: 22px;
		}

		.login-title {
			font-family: var(--font-secondary);
			font-size: var(--font-2xl);
			color: white;
			text-align: center;
			margin-bottom: 2rem;
			border: none;
			padding-bottom: 0;
			font-weight: 800;
		}
		.form-actions {
			margin-top: 2rem;
		}
		.btn-submit {
			width: 100%;
			font-size: var(--font-base);
			padding: 0.9rem;
			border-radius: 9999px;
			background-color: var(--bumble-yellow);
			color: var(--bumble-black);
			font-weight: 800;
			cursor: pointer;
			border: 2px solid var(--bumble-black);
			transition: all 0.2s ease;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}
		.btn-submit:hover {
			background-color: white;
			transform: translateY(-2px);
			box-shadow: 0 6px 16px rgba(255, 255, 255, 0.2);
		}
		.btn-submit:disabled {
			background-color: var(--bumble-text-light);
			cursor: not-allowed;
			border-color: transparent;
		}
		.signup-prompt {
			text-align: center;
			margin-top: 2rem;
			font-size: var(--font-sm);
			color: #c4c4c2;
			font-weight: 500;
		}
		.signup-prompt a {
			color: var(--bumble-yellow);
			text-decoration: underline;
			font-weight: 700;
		}
		.login-card label {
			color: #e4e4e2;
		}
		.login-card input {
			background-color: white;
			color: var(--bumble-black);
			border: 2px solid transparent;
		}
		.login-card input:focus {
			border-color: var(--bumble-yellow);
		}
	</style>

	<div class="login-card">
		<h1 class="login-title">Log In to moonine</h1>

		<div id="form-error-message" style="display: none; background-color: #fef2f2; border: 2px solid #ff4444; color: #b91c1c; padding: 0.75rem 1rem; border-radius: 12px; margin-bottom: 1.5rem; font-size: var(--font-sm); text-align: center; font-weight: 600;"></div>

		<form id="loginForm" novalidate style="background: none; border: none; padding: 0; gap: 1.25rem;">
			<div class="field">
				<label for="phone">Mobile Number</label>
				<input type="tel" id="phone" name="phone" required pattern="[0-9]{10}" placeholder="Enter your 10-digit mobile number" maxlength="10" />
			</div>
			<div class="field" style="margin-top: 1rem;">
				<label for="pin">4-digit PIN</label>
				<input type="password" id="pin" name="pin" required pattern="[0-9]{4}" placeholder="Enter your 4-digit PIN" maxlength="4" inputmode="numeric" />
			</div>
			<div class="form-actions">
				<button type="submit" id="submitBtn" class="btn-submit">Log In</button>
			</div>
		</form>

		<p class="signup-prompt">
			Don't have an profile yet? <a href="/create-profile">Sign Up</a>
		</p>
	</div>

	<script>
		import { setCookie, clearUserData } from '../lib/user';
		import { fetchUsers, invalidateUsersCache } from '../lib/api';

		const form = document.getElementById('loginForm') as HTMLFormElement;
		const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
		const phoneInput = document.getElementById('phone') as HTMLInputElement;
		const pinInput = document.getElementById('pin') as HTMLInputElement;
		const errorMsgEl = document.getElementById('form-error-message') as HTMLDivElement;

		const showError = (msg: string, focusEl?: HTMLElement) => {
			if (errorMsgEl) {
				errorMsgEl.textContent = msg;
				errorMsgEl.style.display = 'block';
			} else {
				alert(msg);
			}
			if (focusEl) focusEl.focus();
		};

		form?.addEventListener('submit', async (e) => {
			e.preventDefault();

			if (errorMsgEl) errorMsgEl.style.display = 'none';

			const phoneVal = phoneInput.value.trim();
			const pinVal = pinInput.value.trim();

			const phoneRegex = /^[0-9]{10}$/;
			if (!phoneVal || !phoneRegex.test(phoneVal)) {
				showError('Please enter a valid 10-digit mobile number.', phoneInput);
				return;
			}

			const pinRegex = /^[0-9]{4}$/;
			if (!pinVal || !pinRegex.test(pinVal)) {
				showError('Please enter a valid 4-digit numeric PIN.', pinInput);
				return;
			}

			submitBtn.disabled = true;
			submitBtn.textContent = 'Logging in...';

			try {
				// Clear any previous session details
				clearUserData();
				invalidateUsersCache();

				const users = await fetchUsers();

				// Find user profile with exact matching mobile and PIN
				const foundUser = users.find(u => u.phone === phoneVal && u.pin === pinVal);

				if (foundUser) {
					// Prepare user_details cookie payload
					const userDetailsPayload = {
						uid: foundUser.uid,
						name: foundUser.name,
						email: foundUser.email,
						phone: foundUser.phone,
						pin: foundUser.pin,
						dob: foundUser.dob,
						tob: foundUser.tob,
						gender: foundUser.gender,
						location: foundUser.location,
						lat: foundUser.lat,
						lon: foundUser.lon,
						currentLocation: foundUser.currentLocation,
						currentLat: foundUser.currentLat,
						currentLon: foundUser.currentLon,
						height: foundUser.height,
						maritalStatus: foundUser.maritalStatus || 'available',
						education: foundUser.education,
						occupation: foundUser.occupation,
						income: foundUser.income,
						religion: foundUser.religion,
						bio: foundUser.bio
					};

					// Save credentials to standard cookies
					setCookie('uid', foundUser.uid, 365);
					setCookie('user_details', JSON.stringify(userDetailsPayload), 365);

					// Force invalidate API cache to reload with new context
					invalidateUsersCache();

					window.location.href = '/dashboard';
				} else {
					showError('Profile not found or incorrect 4-digit PIN. Please try again.', pinInput);
					submitBtn.disabled = false;
					submitBtn.textContent = 'Log In';
				}

			} catch (err) {
				console.error('Login process failure:', err);
				showError('Connection error. Please try again later.');
				submitBtn.disabled = false;
				submitBtn.textContent = 'Log In';
			}
		});
	</script>
</Layout>
