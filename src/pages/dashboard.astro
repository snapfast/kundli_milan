---
import Layout from '../layouts/Layout.astro';
---

<Layout title="moonine">
	<style is:global>
		.dashboard-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
			gap: 0.75rem;
			margin-bottom: 1.5rem;
		}
		.info-card {
			background: #fff;
			border: 2px solid var(--bumble-border);
			padding: 0.75rem 1rem;
			border-radius: 14px;
			box-shadow: 0 4px 12px rgba(143,118,99,0.01);
		}
		.info-item {
			display: flex;
			flex-direction: column;
		}
		.info-label {
			font-weight: 800;
			color: var(--bumble-text-light);
			font-size: var(--font-xs);
			text-transform: uppercase;
			letter-spacing: 0.05em;
			margin-bottom: 0.2rem;
		}
		.info-value {
			font-size: var(--font-sm);
			color: var(--bumble-text);
			font-weight: 600;
			word-break: normal;
			overflow-wrap: break-word;
			line-height: 1.2;
		}
		.section-title {
			font-size: var(--font-base);
			margin: 1.5rem 0 1rem 0;
			border-bottom: 2.5px solid var(--bumble-yellow);
			padding-bottom: 0.35rem;
			font-weight: 800;
			color: var(--bumble-text);
			text-transform: uppercase;
			letter-spacing: 0.03em;
		}
		.compact-table {
			width: 100%;
			border-collapse: collapse;
			font-size: var(--font-xs);
			background: #fff;
			border-radius: 12px;
			overflow: hidden;
			border: 2px solid var(--bumble-border);
		}
		.compact-table th, .compact-table td {
			padding: 0.5rem 0.75rem;
			text-align: left;
			border-bottom: 1px solid var(--bumble-border);
			color: var(--bumble-text);
		}
		.compact-table th {
			background-color: var(--bumble-light-grey);
			color: var(--bumble-text);
			font-weight: 800;
			text-transform: uppercase;
			font-size: 0.75rem;
			letter-spacing: 0.02em;
		}
		.loading-container {
			text-align: center;
			padding: 4rem 2rem;
		}
		.loader {
			border: 4px solid var(--bumble-border);
			border-top: 4px solid var(--bumble-yellow);
			border-radius: 50%;
			width: 44px;
			height: 44px;
			animation: spin 1s cubic-bezier(0.55, 0.085, 0.68, 0.53) infinite;
			margin: 0 auto 1.5rem;
		}
		@keyframes spin {
			0% { transform: rotate(0deg); }
			100% { transform: rotate(360deg); }
		}
		.dosha-container {
			margin: 0.75rem 0;
			padding: 0.75rem 1rem;
			background: #fef2f2;
			border-left: 3px solid #ef4444;
			border-radius: 8px;
		}
		.dosha-header {
			font-weight: 800;
			color: #991b1b;
			font-size: var(--font-xs);
			text-transform: uppercase;
			margin-bottom: 0.3rem;
		}
		.dosha-item {
			margin-bottom: 0.3rem;
		}
		.dosha-item:last-child {
			margin-bottom: 0;
		}
		.dosha-item.cancelled {
			border-left-color: #10b981;
			background: #f0fdf4;
		}
		.dosha-item.cancelled .dosha-name {
			color: #059669;
			text-decoration: line-through;
		}
		.dosha-name {
			font-weight: 700;
			color: var(--bumble-text);
			font-size: var(--font-xs);
		}
		.dosha-description {
			font-size: var(--font-xs);
			color: var(--bumble-text-light);
			line-height: 1.3;
		}
		.no-data {
			text-align: center;
			padding: 4rem 2rem;
			color: var(--bumble-text);
			background-color: white;
			border-radius: 20px;
			border: 2px solid var(--bumble-border);
		}
		.btn-group {
			margin: 2.5rem 0;
			display: flex;
			gap: 1rem;
			flex-wrap: wrap;
		}
		.btn-sm {
			padding: 0.6rem 1.25rem;
			font-size: var(--font-sm);
			border-radius: 9999px;
			font-weight: 700;
		}
		.koota-details {
			margin-top: 0.75rem;
			background: var(--bumble-light-grey);
			border-radius: 12px;
			padding: 0.5rem 0.75rem;
			border: 1px solid #e4e4e2;
		}
		.koota-summary {
			font-size: var(--font-xs);
			font-weight: 700;
			color: var(--bumble-text);
			cursor: pointer;
			padding: 0.4rem 0;
			display: list-item;
			text-transform: uppercase;
			letter-spacing: 0.02em;
		}
		.koota-summary:hover {
			color: var(--bumble-yellow-hover);
		}
		.floating-scroll-btns {
			position: fixed;
			bottom: 1.5rem;
			right: 1.5rem;
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			z-index: 1000;
		}
		.scroll-btn {
			width: 3rem;
			height: 3rem;
			border-radius: 50%;
			background-color: var(--bumble-yellow);
			color: var(--bumble-text);
			border: 2px solid var(--bumble-yellow);
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			box-shadow: 0 4px 12px rgba(143,118,99,0.15);
			transition: all 0.2s;
		}
		.scroll-btn:hover {
			background-color: white;
			transform: scale(1.1);
		}
		.scroll-btn:active {
			transform: scale(0.95);
		}
	</style>

	<h1 style="font-family: var(--font-secondary); font-size: var(--font-3xl); border-bottom: none; text-align: center; margin-bottom: 2rem;">moonine</h1>

	<div id="loading" class="loading-container">
		<div class="loader"></div>
		<p style="font-weight: 600; color: var(--bumble-text);">Matching your stars and calculating Kundli Milan with other users...</p>
	</div>

	<div id="dashboard-content" style="display: none;">
		<details open>
			<summary id="matches-opposite-title" class="section-title" style="cursor: pointer; list-style-position: inside;">Matches (Opposite Sex)</summary>
			<div id="matches-list-opposite">
				<!-- Opposite sex matches injected here -->
			</div>
		</details>

		<details id="nearest-section-opposite" style="display: none; margin-top: 1.5rem;">
			<summary id="nearest-opposite-title" class="section-title" style="cursor: pointer; list-style-position: inside;">Top 10 Nearest People (Opposite Sex)</summary>
			<div id="nearest-list-opposite">
				<!-- Nearest opposite sex matches injected here -->
			</div>
		</details>

		<details style="margin-top: 1.5rem;">
			<summary class="section-title" style="cursor: pointer; list-style-position: inside;">Matches</summary>
			<div id="matches-list">
				<!-- Matches injected here -->
			</div>
		</details>

		<details id="nearest-section" style="display: none; margin-top: 1.5rem;">
			<summary class="section-title" style="cursor: pointer; list-style-position: inside;">Top 10 Nearest People</summary>
			<div id="nearest-list">
				<!-- Nearest matches injected here -->
			</div>
		</details>
	</div>

	<div id="no-profile" style="display: none;" class="no-data">
		<p style="font-weight: 700; margin-bottom: 1.5rem; font-size: var(--font-lg);">We couldn't find your moonine - A Vedic Matchmaker profile.</p>
		<p style="margin-bottom: 1.5rem; color: var(--bumble-text-light);">Please share your birth details to get started!</p>
		<a href="/create-profile" class="btn">Create Profile</a>
	</div>

	<div id="error-state" style="display: none;" class="no-data">
		<p style="color: #ff4444; font-weight: 800; font-size: var(--font-lg); margin-bottom: 1rem;">Error connecting to the stars.</p>
		<p style="color: var(--bumble-text-light);">We encountered a problem while fetching moonine - A Vedic Matchmaker data. Please try again later.</p>
	</div>

	<div id="floating-scroll-btns" class="floating-scroll-btns" style="display: none;">
		<button id="scroll-up-btn" class="scroll-btn" aria-label="Page up">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
				<path d="M18 15l-6-6-6 6"/>
			</svg>
		</button>
		<button id="scroll-down-btn" class="scroll-btn" aria-label="Page down">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
				<path d="M6 9l6 6 6-6"/>
			</svg>
		</button>
	</div>

	<script>
		import { getOrSetUserId, clearUserData, getCookie } from '../lib/user';
		import { fetchUsers, saveUserProfile, type UserProfile } from '../lib/api';
		import { calculateAstrology } from '../lib/astrology';
		import { calculateCompatibility } from '../lib/compatibility';
		import { KOOTA_INFO } from '../lib/constants';
		import { generateMatchCardHtml } from '../lib/ui';

		// Haversine distance formula in kilometers
		function getDistanceFromLatLonInKm(lat1: number, lon1: number, lat2: number, lon2: number) {
			const R = 6371; // Radius of the earth in km
			const dLat = deg2rad(lat2 - lat1);
			const dLon = deg2rad(lon2 - lon1);
			const a =
				Math.sin(dLat / 2) * Math.sin(dLat / 2) +
				Math.cos(deg2rad(lat1)) * Math.cos(deg2rad(lat2)) *
				Math.sin(dLon / 2) * Math.sin(dLon / 2);
			const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
			const d = R * c; // Distance in km
			return d;
		}

		function deg2rad(deg: number) {
			return deg * (Math.PI / 180);
		}

		window.addEventListener('load', async () => {
			const uid = getOrSetUserId();
			const stored = getCookie('user_details');

			if (!stored) {
				document.getElementById('loading')!.style.display = 'none';
				document.getElementById('no-profile')!.style.display = 'block';
				return;
			}

			const details = JSON.parse(stored);

			let oppositeGenderText = 'Opposite Sex';
			if (details.gender) {
				const g = details.gender.toLowerCase();
				if (g === 'male') oppositeGenderText = 'Females';
				else if (g === 'female') oppositeGenderText = 'Males';
			}

			const matchesOppositeTitle = document.getElementById('matches-opposite-title');
			if (matchesOppositeTitle) {
				matchesOppositeTitle.textContent = `Matches (${oppositeGenderText})`;
			}

			const nearestOppositeTitle = document.getElementById('nearest-opposite-title');
			if (nearestOppositeTitle) {
				nearestOppositeTitle.textContent = `Top 10 Nearest People (${oppositeGenderText})`;
			}

			function formatTime12h(t24: string): string {
				if (!t24) return "";
				const [h24, m] = t24.split(':');
				let h = parseInt(h24);
				const ampm = h >= 12 ? 'PM' : 'AM';
				h = h % 12;
				if (h === 0) h = 12;
				return `${h.toString().padStart(2, '0')}:${m} ${ampm}`;
			}

			try {
				const users = await fetchUsers();
				let profile = users.find(u => u.uid === uid);

				const lat = details.lat ? parseFloat(details.lat) : 28.6139;
				const lon = details.lon ? parseFloat(details.lon) : 77.2090;
				const astroData = calculateAstrology(details.dob, details.tob, lat, lon);

				// Determine if we need to update the backend
				const otherUsersCount = users.filter(u => u.uid !== uid && u.name).length;
				const hasMatches = profile && profile.matches && profile.matches.length > 0;

				// We should update if:
				// 1. Profile is missing from backend
				// 2. Matches are missing but there are other users to match with
				// 3. Local details differ from backend details (e.g. name, dob changed)

				let needsUpdate = !profile;

				if (profile) {
					const detailsChanged =
						profile.name !== details.name ||
						profile.dob !== details.dob ||
						profile.tob !== details.tob ||
						profile.location !== details.location ||
						profile.currentLocation !== details.currentLocation ||
						profile.currentLat !== details.currentLat ||
						profile.currentLon !== details.currentLon;

					const matchesMissing = !hasMatches && otherUsersCount > 0;

					// Check if nearest is missing but user has location set
					const nearestMissing = (!profile.nearest || profile.nearest.length === 0) && (details.currentLat && details.currentLon) && otherUsersCount > 0;
					const matchesOppositeMissing = (!profile.matchesOppositeSex || profile.matchesOppositeSex.length === 0) && otherUsersCount > 0;
					const nearestOppositeMissing = (!profile.nearestOppositeSex || profile.nearestOppositeSex.length === 0) && (details.currentLat && details.currentLon) && otherUsersCount > 0;

					if (detailsChanged || matchesMissing || nearestMissing || matchesOppositeMissing || nearestOppositeMissing) {
						needsUpdate = true;
					}
				}

				if (needsUpdate) {
					console.log('Updating profile and matches on backend...');
					const otherUsers = users.filter(u => u.uid !== uid && u.name && u.dob && u.tob);
					const currentUserAstrology = {
						name: details.name,
						nakshatraIdx: astroData.panchang.nakshatraIdx,
						moonSignIdx: astroData.panchang.moonSignIdx,
						isMoonManglik: astroData.panchang.isMoonManglik,
						isLaganManglik: astroData.panchang.isLaganManglik,
						gender: details.gender
					};

					// Determine if user has a current location for "nearest" feature
					const hasCurrentLocation = details.currentLat && details.currentLon;
					const myLat = hasCurrentLocation ? parseFloat(details.currentLat) : undefined;
					const myLon = hasCurrentLocation ? parseFloat(details.currentLon) : undefined;

					const resultsWithScores = otherUsers.map(user => {
						let uNakIdx = user.nakshatraIdx;
						let uMoonSignIdx = user.moonSignIdx;
						let uIsMoonManglik = user.isMoonManglik;
						let uIsLaganManglik = user.isLaganManglik;

						if ((uNakIdx === undefined || uMoonSignIdx === undefined || uIsMoonManglik === undefined) && user.dob && user.tob) {
							try {
								const uLat = user.lat ? parseFloat(user.lat) : 28.6139;
								const uLon = user.lon ? parseFloat(user.lon) : 77.2090;
								const uData = calculateAstrology(user.dob, user.tob, uLat, uLon);
								uNakIdx = uData.panchang.nakshatraIdx;
								uMoonSignIdx = uData.panchang.moonSignIdx;
								uIsMoonManglik = uData.panchang.isMoonManglik;
								uIsLaganManglik = uData.panchang.isLaganManglik;
							} catch (e) {
								console.warn(`Failed to calculate astrology for user ${user.uid}`, e);
							}
						}

						const compat = calculateCompatibility(currentUserAstrology, {
							name: user.name,
							nakshatraIdx: uNakIdx!,
							moonSignIdx: uMoonSignIdx!,
							isMoonManglik: uIsMoonManglik,
							isLaganManglik: uIsLaganManglik,
							gender: user.gender
						});

						// Calculate distance if both users have locations
						let distance = undefined;
						if (hasCurrentLocation) {
							// Use target user's current location, fallback to birth location
							let tLat = user.currentLat ? parseFloat(user.currentLat) : (user.lat ? parseFloat(user.lat) : undefined);
							let tLon = user.currentLon ? parseFloat(user.currentLon) : (user.lon ? parseFloat(user.lon) : undefined);
							if (tLat !== undefined && tLon !== undefined && myLat !== undefined && myLon !== undefined) {
								distance = getDistanceFromLatLonInKm(myLat, myLon, tLat, tLon);
							}
						}

						return { user, compat, distance };
					});

					resultsWithScores.sort((a, b) => b.compat.score - a.compat.score);
					const top10 = resultsWithScores.slice(0, 10);

					const oppositeSexScores = resultsWithScores.filter(r => r.user.gender && details.gender && r.user.gender.toLowerCase() !== details.gender.toLowerCase());
					const top10OppositeSex = oppositeSexScores.slice(0, 10);

					let top10Nearest: any[] = [];
					let top10NearestOppositeSex: any[] = [];
					if (hasCurrentLocation) {
						const withDistance = resultsWithScores.filter(r => r.distance !== undefined);
						withDistance.sort((a, b) => a.distance! - b.distance!);
						top10Nearest = withDistance.slice(0, 10);

						const withDistanceOpp = oppositeSexScores.filter(r => r.distance !== undefined);
						withDistanceOpp.sort((a, b) => a.distance! - b.distance!);
						top10NearestOppositeSex = withDistanceOpp.slice(0, 10);
					}

					const updatedProfile: UserProfile = {
						...details,
						uid: uid,
						nakshatraIdx: astroData.panchang.nakshatraIdx,
						moonSignIdx: astroData.panchang.moonSignIdx,
						isMoonManglik: astroData.panchang.isMoonManglik,
						isLaganManglik: astroData.panchang.isLaganManglik,
						matches: top10.map(m => ({
							uid: m.user.uid,
							name: m.user.name,
							score: m.compat.score,
							category: m.compat.category,
							description: m.compat.description,
							maxScore: m.compat.maxScore,
							kootas: m.compat.kootas,
							doshas: m.compat.doshas
						})),
						nearest: top10Nearest.map(m => ({
							uid: m.user.uid,
							name: m.user.name,
							score: m.compat.score,
							category: m.compat.category,
							description: m.compat.description,
							distance: m.distance,
							maxScore: m.compat.maxScore,
							kootas: m.compat.kootas,
							doshas: m.compat.doshas
						})),
						matchesOppositeSex: top10OppositeSex.map(m => ({
							uid: m.user.uid,
							name: m.user.name,
							score: m.compat.score,
							category: m.compat.category,
							description: m.compat.description,
							maxScore: m.compat.maxScore,
							kootas: m.compat.kootas,
							doshas: m.compat.doshas
						})),
						nearestOppositeSex: top10NearestOppositeSex.map(m => ({
							uid: m.user.uid,
							name: m.user.name,
							score: m.compat.score,
							category: m.compat.category,
							description: m.compat.description,
							distance: m.distance,
							maxScore: m.compat.maxScore,
							kootas: m.compat.kootas,
							doshas: m.compat.doshas
						}))
					};

					// Use a session flag to avoid multiple saves in one session if something loops
					if (!window.sessionStorage.getItem('profile_saved_' + uid)) {
						await saveUserProfile(updatedProfile);
						window.sessionStorage.setItem('profile_saved_' + uid, 'true');
					}
					profile = updatedProfile;
				}

				// Rendering
				document.getElementById('loading')!.style.display = 'none';
				document.getElementById('dashboard-content')!.style.display = 'block';

				const floatingBtns = document.getElementById('floating-scroll-btns');
				if (floatingBtns) {
					floatingBtns.style.display = 'flex';
				}

				const scrollUpBtn = document.getElementById('scroll-up-btn');
				const scrollDownBtn = document.getElementById('scroll-down-btn');

				if (scrollUpBtn) {
					scrollUpBtn.addEventListener('click', () => {
						window.scrollTo({ top: 0, behavior: 'smooth' });
					});
				}

				if (scrollDownBtn) {
					scrollDownBtn.addEventListener('click', () => {
						window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
					});
				}

				const matchesList = document.getElementById('matches-list')!;
				matchesList.innerHTML = '';

				function renderMatches(listContainer: HTMLElement, matchesData: any[], showDistance: boolean = false) {
					if (matchesData && matchesData.length > 0) {
						matchesData.forEach((m: any) => {
							const otherUser = users.find(u => u.uid === m.uid);
							let kootaHtml = '';
							let age: number | undefined = undefined;

							if (otherUser) {
								const uDob = typeof otherUser.dob === 'string' && otherUser.dob.includes('T') ? otherUser.dob.split('T')[0] : otherUser.dob;
								if (uDob) {
									const dobDate = new Date(uDob);
									const today = new Date();
									age = today.getFullYear() - dobDate.getFullYear();
									const m = today.getMonth() - dobDate.getMonth();
									if (m < 0 || (m === 0 && today.getDate() < dobDate.getDate())) {
										age--;
									}
								}
								let compat = {
									kootas: m.kootas || [],
									doshas: m.doshas || [],
									description: m.description || '',
									score: m.score || 0,
									maxScore: m.maxScore || 36
								};

																	// Fallback if kootas weren't saved in the backend
									if (!m.kootas || m.kootas.length === 0) {
										let uNakIdx = otherUser.nakshatraIdx;
										let uMoonSignIdx = otherUser.moonSignIdx;
										let uIsMoonManglik = otherUser.isMoonManglik;
										let uIsLaganManglik = otherUser.isLaganManglik;

										if (uNakIdx === undefined || uMoonSignIdx === undefined || uIsMoonManglik === undefined || uIsLaganManglik === undefined) {
											const uLat = otherUser.lat ? parseFloat(otherUser.lat) : 28.6139;
											const uLon = otherUser.lon ? parseFloat(otherUser.lon) : 77.2090;

											// Ensure dob and tob are in correct format if they came back as ISO strings or something else from backend
											const uTob = typeof otherUser.tob === 'string' && otherUser.tob.includes('T') ? otherUser.tob.split('T')[1].substring(0, 5) : otherUser.tob;

											const uData = calculateAstrology(uDob, uTob, uLat, uLon);
											uNakIdx = uNakIdx ?? uData.panchang.nakshatraIdx;
											uMoonSignIdx = uMoonSignIdx ?? uData.panchang.moonSignIdx;
											uIsMoonManglik = uIsMoonManglik ?? uData.panchang.isMoonManglik;
											uIsLaganManglik = uIsLaganManglik ?? uData.panchang.isLaganManglik;
										}

										// Prioritize pre-calculated indices from profile for consistency
										compat = calculateCompatibility(
											{
												name: profile.name,
												nakshatraIdx: profile.nakshatraIdx ?? astroData.panchang.nakshatraIdx,
												moonSignIdx: profile.moonSignIdx ?? astroData.panchang.moonSignIdx,
												isMoonManglik: profile.isMoonManglik ?? astroData.panchang.isMoonManglik,
												isLaganManglik: profile.isLaganManglik ?? astroData.panchang.isLaganManglik,
												gender: profile.gender
											},
											{
												name: otherUser.name,
												nakshatraIdx: uNakIdx!,
												moonSignIdx: uMoonSignIdx!,
												isMoonManglik: uIsMoonManglik,
												isLaganManglik: uIsLaganManglik,
												gender: otherUser.gender
											}
										);
									}

								kootaHtml = `
									<details class="koota-details">
										<summary class="koota-summary">View Guna Milan Details</summary>
										<div style="overflow-x: auto; margin-top: 0.5rem;">
											<table class="compact-table">
												<thead>
													<tr>
														<th>#</th>
														<th>Guna</th>
														<th>Girl</th>
														<th>Boy</th>
														<th>Obtained</th>
														<th>Max</th>
														<th>Area of Life</th>
													</tr>
												</thead>
												<tbody>
													${compat.kootas.map((k: any, idx: number) => `
														<tr>
															<td>${idx + 1}</td>
															<td>${k.name}</td>
															<td>${k.girlValue}</td>
															<td>${k.boyValue}</td>
															<td>${k.score}</td>
															<td>${k.max}</td>
															<td>${k.areaOfLife}</td>
														</tr>
													`).join('')}
												</tbody>
												<tfoot>
													<tr style="background: var(--bumble-light-grey); font-weight: 800; color: var(--bumble-text);">
														<td colspan="4" style="text-align: right;">Total Guna Milan Points</td>
														<td>${compat.score}</td>
														<td>${compat.maxScore}</td>
														<td></td>
													</tr>
												</tfoot>
											</table>
										</div>
									</details>
								`;

								const distanceHtml = showDistance && m.distance !== undefined ?
									`<div style="font-size: var(--font-sm); color: var(--bumble-text); margin-bottom: 0.75rem; font-weight: 800; display: inline-flex; align-items: center; gap: 0.25rem; background-color: var(--bumble-yellow); padding: 0.25rem 0.75rem; border-radius: 9999px; border: 1.5px solid var(--bumble-text); box-shadow: 1.5px 1.5px 0 var(--bumble-text);">📍 Approx. ${Math.round(m.distance)} km away</div>` : '';

								const card = document.createElement('div');
								card.className = 'match-card';
								card.innerHTML = (distanceHtml ? `<div style="margin-bottom: 0.75rem;">${distanceHtml}</div>` : '') + generateMatchCardHtml(m.uid, m.name, age, m.category, m.score, compat.description, kootaHtml, compat.doshas);
								listContainer.appendChild(card);
							}
						});
					} else {
						listContainer.innerHTML = '<div class="no-data"><p style="font-weight: 600; margin: 0;">No matches found yet. They will appear here as more people join!</p></div>';
					}
				}

				if (profile.matches) {
					renderMatches(matchesList, profile.matches);
				} else {
					matchesList.innerHTML = '<div class="no-data"><p style="font-weight: 600; margin: 0;">No matches found yet. They will appear here as more people join!</p></div>';
				}

				const matchesListOpposite = document.getElementById('matches-list-opposite')!;
				matchesListOpposite.innerHTML = '';
				if (profile.matchesOppositeSex) {
					renderMatches(matchesListOpposite, profile.matchesOppositeSex);
				} else {
					matchesListOpposite.innerHTML = `<div class="no-data"><p style="font-weight: 600; margin: 0;">No ${oppositeGenderText.toLowerCase()} matches found yet. They will appear here as more people join!</p></div>`;
				}

				const nearestSection = document.getElementById('nearest-section')!;
				const nearestList = document.getElementById('nearest-list')!;
				nearestList.innerHTML = '';

				const nearestSectionOpposite = document.getElementById('nearest-section-opposite')!;
				const nearestListOpposite = document.getElementById('nearest-list-opposite')!;
				nearestListOpposite.innerHTML = '';

				if (profile.currentLat && profile.currentLon) {
					nearestSection.style.display = 'block';
					if (profile.nearest) {
						renderMatches(nearestList, profile.nearest, true);
					} else {
						nearestList.innerHTML = '<div class="no-data"><p style="font-weight: 600; margin: 0;">No people found nearby yet.</p></div>';
					}

					nearestSectionOpposite.style.display = 'block';
					if (profile.nearestOppositeSex) {
						renderMatches(nearestListOpposite, profile.nearestOppositeSex, true);
					} else {
						nearestListOpposite.innerHTML = `<div class="no-data"><p style="font-weight: 600; margin: 0;">No ${oppositeGenderText.toLowerCase()} found nearby yet.</p></div>`;
					}
				} else {
					nearestSection.style.display = 'none';
					nearestSectionOpposite.style.display = 'none';
				}

			} catch (error) {
				console.error("Dashboard error:", error);
				document.getElementById('loading')!.style.display = 'none';
				document.getElementById('error-state')!.style.display = 'block';
			}
		});
	</script>
</Layout>
