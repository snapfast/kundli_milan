---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cosmic Dashboard">
	<style>
		.profile-summary {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
			gap: 1.5rem;
			margin-bottom: 2rem;
			background: #fff;
			border: 1px solid #e1e4e8;
			padding: 1.5rem;
			border-radius: 8px;
		}
		.summary-item {
			display: flex;
			flex-direction: column;
		}
		.label {
			font-weight: bold;
			color: #7f8c8d;
			font-size: 0.85rem;
			text-transform: uppercase;
		}
		.value {
			font-size: 1.2rem;
			color: #2d3436;
		}
		.no-data {
			text-align: center;
			padding: 3rem;
			color: #636e72;
		}
	</style>

	<h1>Your Cosmic Dashboard</h1>

			<div id="loading">Syncing with the stars...</div>

			<div id="dashboard-content" style="display: none;">
				<div class="profile-summary" id="profile-summary">
					<!-- Profile data injected here -->
				</div>

				<div style="margin-bottom: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
					<a href="/kundli" class="btn">View My Kundli</a>
					<a href="/?edit=true" class="btn">Edit My Profile</a>
					<button id="resetProfileBtn" class="btn" style="background-color: #dc3545;">Reset My Profile</button>
				</div>

				<h2>Your Current Top Matches</h2>
				<div id="matches-list">
					<!-- Matches injected here -->
				</div>
			</div>

			<div id="no-profile" style="display: none;" class="no-data">
				<p>We couldn't find your cosmic profile. Please share your birth details to get started!</p>
				<a href="/" class="btn">Create Profile</a>
			</div>

			<div id="error-state" style="display: none;" class="no-data">
				<p style="color: #dc3545; font-weight: bold;">Error connecting to the stars.</p>
				<p>We encountered a problem while fetching cosmic data. Please try again later.</p>
			</div>

	<script>
			import { getOrSetUserId, clearUserData } from '../lib/user';
			import { fetchUsers, resetUserProfile } from '../lib/api';
			import { calculateCompatibility } from '../lib/compatibility';
			import { KOOTA_INFO } from '../lib/constants';
			import { generateMatchCardHtml } from '../lib/ui';

			window.addEventListener('load', async () => {
				const uid = getOrSetUserId();
				const resetBtn = document.getElementById('resetProfileBtn') as HTMLButtonElement;

				resetBtn?.addEventListener('click', async () => {
					if (confirm('Are you sure you want to reset your cosmic profile? This will delete all your data and you will start fresh.')) {
						if (uid) await resetUserProfile(uid);
						clearUserData();
						window.location.href = '/';
					}
				});

				let users: any[] = [];
				let profile: any = null;

				try {
					users = await fetchUsers();
					profile = users.find(u => u.uid === uid);
				} catch (error) {
					console.error("Error loading dashboard data:", error);
					document.getElementById('loading')!.style.display = 'none';
					document.getElementById('error-state')!.style.display = 'block';
					return;
				}

				document.getElementById('loading')!.style.display = 'none';

				if (profile) {
					const summary = document.getElementById('profile-summary')!;
					summary.innerHTML = `
						<div class="summary-item">
							<span class="label">Name</span>
							<span class="value">${profile.name}</span>
						</div>
						<div class="summary-item">
							<span class="label">Email</span>
							<span class="value">${profile.email}</span>
						</div>
						<div class="summary-item">
							<span class="label">Born</span>
							<span class="value">${profile.dob} at ${profile.tob}</span>
						</div>
						<div class="summary-item">
							<span class="label">Location</span>
							<span class="value">${profile.location}</span>
						</div>
						<div class="summary-item">
							<span class="label">Gender</span>
							<span class="value" style="text-transform: capitalize;">${profile.gender}</span>
						</div>
						<div class="summary-item">
							<span class="label">Manglik Status</span>
							<span class="value">${profile.isManglik ? 'Manglik' : 'Non-Manglik'}</span>
						</div>
					`;

					const matchesList = document.getElementById('matches-list')!;
					if (profile.matches && profile.matches.length > 0) {
						profile.matches.forEach((m: any) => {
							const otherUser = users.find(u => (m.uid && u.uid === m.uid) || (!m.uid && u.name === m.name));
							let kootaHtml = '';

							if (otherUser && profile.nakshatraIdx !== undefined && otherUser.nakshatraIdx !== undefined) {
								const compat = calculateCompatibility(
									{ name: profile.name, nakshatraIdx: profile.nakshatraIdx, moonSignIdx: profile.moonSignIdx!, isManglik: profile.isManglik },
									{ name: otherUser.name, nakshatraIdx: otherUser.nakshatraIdx, moonSignIdx: otherUser.moonSignIdx!, isManglik: otherUser.isManglik }
								);

								kootaHtml = `
									<div class="koota-grid">
										${compat.kootas.map(k => `
											<div class="koota-item">
												${k.name}: ${k.score}/${k.max}
												<div class="koota-explanation">${KOOTA_INFO[k.name] || ""}</div>
											</div>
										`).join('')}
									</div>
								`;
							}

							const card = document.createElement('div');
							card.className = 'match-card';
							card.innerHTML = generateMatchCardHtml(m.name, m.category, m.score, "", kootaHtml);
							matchesList.appendChild(card);
						});
					} else {
						matchesList.innerHTML = '<p>No matches found yet. We will update your dashboard as more people join!</p>';
					}

					document.getElementById('dashboard-content')!.style.display = 'block';
				} else {
					document.getElementById('no-profile')!.style.display = 'block';
				}
			});
	</script>
</Layout>
