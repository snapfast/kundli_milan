---
import Layout from '../layouts/Layout.astro';
---

<Layout title="moonine - Free Vedic Matchmaking & Kundli Milan" description="Find compatible life partners with moonine - A Vedic Matchmaker. Accurate Guna Milan, Nakshatra compatibility, and manual profiling based on Vedic astrology.">
	<style>
		/* Custom Honeycomb & Bumble landing page styles */
		.bumble-landing {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			background: linear-gradient(135deg, var(--bumble-yellow) 0%, var(--bumble-light-yellow) 100%);
			color: var(--bumble-text);
			padding: 4.5rem 2rem;
			border-radius: 28px;
			margin-bottom: 2rem;
			position: relative;
			overflow: hidden;
			box-shadow: 0 12px 36px rgba(143,118,99,0.08);
			border: 2px solid var(--bumble-yellow);
		}

		/* Simple pure CSS honeycomb overlay background pattern */
		.bumble-landing::before {
			content: "";
			position: absolute;
			top: 0; left: 0; right: 0; bottom: 0;
			opacity: 0.12;
			background-color: transparent;
			background-image:
				radial-gradient(circle, var(--bumble-yellow-hover) 2px, transparent 3px),
				radial-gradient(circle, var(--bumble-yellow-hover) 2px, transparent 3px);
			background-size: 30px 30px;
			background-position: 0 0, 15px 15px;
			pointer-events: none;
		}

		.bumble-landing p.subtitle {
			font-size: var(--font-xl);
			color: var(--bumble-text);
			max-width: 600px;
			margin: 1.5rem auto 2.5rem auto;
			line-height: 1.5;
			font-weight: 700;
		}

		/* Dual CTAs must share .btn-cta class */
		.btn-cta {
			font-size: var(--font-lg);
			padding: 0.9rem 2.5rem;
			border-radius: 9999px;
			background-color: var(--bumble-yellow);
			color: var(--bumble-text);
			text-decoration: none;
			font-weight: 800;
			box-shadow: 0 6px 20px rgba(255, 203, 55, 0.3);
			transition: all 0.2s ease;
			display: inline-block;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			border: 2px solid var(--bumble-yellow);
		}
		.btn-cta:hover {
			background-color: var(--bumble-white);
			border-color: var(--bumble-yellow-hover);
		}

		.growing-community-tag {
			margin-top: 2rem;
			color: var(--bumble-text-light);
			font-size: var(--font-sm);
			text-align: center;
			max-width: 550px;
			line-height: 1.6;
			font-weight: 600;
		}

		.info-card {
			background: var(--bumble-white);
			border: 2px solid var(--bumble-border);
			padding: 2rem 1.5rem;
			border-radius: 20px;
			text-align: center;
			box-shadow: 0 6px 16px rgba(143,118,99,0.03);
			transition: all 0.2s ease;
		}
		.info-card:hover {
			border-color: var(--bumble-yellow);
		}
		.info-label {
			font-weight: 800;
			font-size: var(--font-base);
			text-transform: uppercase;
			color: var(--bumble-text);
			margin-bottom: 0.75rem;
			position: relative;
			display: inline-block;
		}
		.info-label::after {
			content: '';
			position: absolute;
			left: 0; right: 0; bottom: -3px;
			height: 3px;
			background-color: var(--bumble-yellow);
		}
		.info-value {
			font-size: var(--font-sm);
			color: var(--bumble-text);
			line-height: 1.6;
			font-weight: 500;
		}
	</style>

	<div id="main-content">
		<section class="bumble-landing">
			<div class="logo" data-text="moonine"><span class="logo-text" style="color: var(--bumble-text);">moonine</span></div>
			<!-- Explicit starting lowercase letter per preferred memory -->
			<p class="subtitle">discover verified local profiles and find the right life partner.</p>
			<div>
				<a href="/create-profile" id="cta-btn" class="btn-cta">Sign Up</a>
			</div>
			<p class="growing-community-tag">
				join our growing community · discover verified local profiles · connect with mindful individuals · personal vetting · privacy first
			</p>
		</section>

		<section class="visual-guide" style="margin-top: 3rem; border-top: 2px solid var(--bumble-border); padding-top: 2.5rem;">
			<h2 style="font-family: var(--font-secondary); font-size: var(--font-2xl); border-bottom: none; text-align: center; margin-bottom: 2rem; color: var(--bumble-text);">Trusted by Families. Rooted in Tradition.</h2>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
				<div class="info-card">
					<div class="info-label">Deep Compatibility</div>
					<div class="info-value">Ensure a harmonious future with traditional 36-point Ashta Koota Milan. We look beyond the surface.</div>
				</div>
				<div class="info-card">
					<div class="info-label">Peace of Mind</div>
					<div class="info-value">Careful analysis of Manglik and other doshas so you can proceed with confidence.</div>
				</div>
				<div class="info-card">
					<div class="info-label">Verified Matches</div>
					<div class="info-value">Every profile is treated with respect and privacy, giving you a secure space to connect.</div>
				</div>
			</div>

			<p style="text-align: center; margin-top: 2rem;">
				<a href="/about" class="btn" style="background-color: var(--bumble-yellow); color: var(--bumble-text); padding: 0.75rem 1.75rem;">About moonine &rarr;</a>
			</p>

			<div style="text-align: center; margin-top: 4rem; margin-bottom: 3rem;">
				<a href="/create-profile" id="cta-btn-bottom" class="btn-cta">Sign Up</a>
			</div>
		</section>
	</div>

	<script>
			import { getCookie } from '../lib/user';
			import { fetchUsers } from '../lib/api';
			import { getOrSetUserId } from '../lib/user';

			const storedDetails = getCookie('user_details');
			const uid = getOrSetUserId();

			function updateCtaButton(name) {
				const ctaBtn = document.getElementById('cta-btn');
				const ctaBtnBottom = document.getElementById('cta-btn-bottom');

				if (ctaBtn && name) {
					ctaBtn.textContent = `Welcome ${name}`;
					ctaBtn.href = '/dashboard';
				}

				if (ctaBtnBottom && name) {
					ctaBtnBottom.textContent = `Welcome ${name}`;
					ctaBtnBottom.href = '/dashboard';
				}
			}

			function updateUserCounter(count) {
				const counterEl = document.getElementById('user-counter');
				if (!counterEl) return;

				// Using 1000 as the minimum threshold before displaying exact numbers
				if (count >= 1000) {
					const formattedCount = count.toLocaleString('en-IN');
					counterEl.textContent = `Join ${formattedCount} verified users finding their match.`;
					counterEl.style.opacity = '1';
				} else {
					counterEl.textContent = 'Join our growing community finding their match.';
					counterEl.style.opacity = '1';
				}
			}

			async function initHomePage() {
				let isLoggedIn = false;
				if (storedDetails) {
					try {
						const details = JSON.parse(decodeURIComponent(storedDetails));
						if (details && details.name) {
							updateCtaButton(details.name);
							isLoggedIn = true;
						}
					} catch (e) {
						console.error('Failed to parse user details:', e);
					}
				}

				try {
					const users = await fetchUsers();
					updateUserCounter(users.length);

					if (!isLoggedIn) {
						const existingUser = users.find(u => u.uid === uid);
						if (existingUser && existingUser.name) {
							updateCtaButton(existingUser.name);
						}
					}
				} catch (error) {
					console.error('Failed to fetch users:', error);
					updateUserCounter(0);
				}
			}

			initHomePage();
	</script>
</Layout>
