---
import { KOOTA_INFO } from '../lib/constants';

interface Props {
    name: string;
    score: number;
    max: number;
}

const { name, score, max } = Astro.props;
---

<div class="koota-item">
    {name}: {score}/{max}
    <div class="koota-explanation">{KOOTA_INFO[name] || ""}</div>
</div>

<style>
    .koota-item {
        font-size: var(--font-sm);
        color: #2d3436;
        background: #f1f2f6;
        padding: 0.4rem;
        border-radius: 4px;
        text-align: center;
        cursor: help;
        position: relative;
    }
    .koota-item:hover .koota-explanation {
        display: block;
    }
    .koota-explanation {
        display: none;
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        background: #333;
        color: white;
        padding: 0.5rem;
        border-radius: 4px;
        width: 200px;
        z-index: 10;
        font-size: var(--font-xs);
        text-align: left;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }
</style>
