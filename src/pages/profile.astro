---
import Layout from '../layouts/Layout.astro';
---

<Layout title="My Profile - moonine Vedic Matchmaker" description="View and manage your private Guna Milan profile and Panchang calculations on moonine." noindex={true}>
	<style is:global>
		.dashboard-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
			gap: 0.75rem;
			margin-bottom: 1.5rem;
		}
		.info-card {
			background: #fff;
			border: 2px solid var(--bumble-border);
			padding: 0.75rem 1rem;
			border-radius: 14px;
			box-shadow: 0 4px 12px rgba(143,118,99,0.01);
			transition: border-color 0.2s ease;
		}
		.info-card:hover {
			border-color: var(--bumble-yellow);
		}
		.info-item {
			display: flex;
			flex-direction: column;
		}
		.info-label {
			font-weight: 800;
			color: var(--bumble-text-light);
			font-size: var(--font-xs);
			text-transform: uppercase;
			letter-spacing: 0.05em;
			margin-bottom: 0.25rem;
		}
		.info-value {
			font-size: var(--font-sm);
			color: var(--bumble-text);
			font-weight: 600;
			word-break: normal;
			overflow-wrap: break-word;
			line-height: 1.2;
		}
		.section-title {
			font-size: var(--font-base);
			margin: 1.5rem 0 1rem 0;
			border-bottom: 2.5px solid var(--bumble-yellow);
			padding-bottom: 0.35rem;
			font-weight: 800;
			color: var(--bumble-text);
			text-transform: uppercase;
			letter-spacing: 0.03em;
		}
		.compact-table {
			width: 100%;
			border-collapse: collapse;
			font-size: var(--font-xs);
			background: #fff;
			border-radius: 12px;
			overflow: hidden;
			border: 2px solid var(--bumble-border);
		}
		.compact-table th, .compact-table td {
			padding: 0.5rem 0.75rem;
			text-align: left;
			border-bottom: 1px solid var(--bumble-border);
			color: var(--bumble-text);
		}
		.compact-table th {
			background-color: var(--bumble-light-grey);
			color: var(--bumble-text);
			font-weight: 800;
			text-transform: uppercase;
			font-size: 0.75rem;
			letter-spacing: 0.02em;
		}
		.loading-container {
			text-align: center;
			padding: 4rem 2rem;
		}
		.loader {
			border: 4px solid var(--bumble-border);
			border-top: 4px solid var(--bumble-yellow);
			border-radius: 50%;
			width: 44px;
			height: 44px;
			animation: spin 1s cubic-bezier(0.55, 0.085, 0.68, 0.53) infinite;
			margin: 0 auto 1.5rem;
		}
		@keyframes spin {
			0% { transform: rotate(0deg); }
			100% { transform: rotate(360deg); }
		}
		.no-data {
			text-align: center;
			padding: 4rem 2rem;
			color: var(--bumble-text);
			background-color: white;
			border-radius: 20px;
			border: 2px solid var(--bumble-border);
		}
		.btn-group {
			margin: 2.5rem 0;
			display: flex;
			gap: 1rem;
			flex-wrap: wrap;
		}
		.btn-sm {
			padding: 0.75rem 1.75rem;
			font-size: var(--font-sm);
			border-radius: 9999px;
			font-weight: 800;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			border: 2px solid var(--bumble-yellow);
			box-shadow: 2px 2px 0 var(--bumble-yellow);
			background-color: var(--bumble-yellow);
			color: var(--bumble-text);
		}
	</style>

	<h1 style="font-family: var(--font-secondary); font-size: var(--font-3xl); border-bottom: none; text-align: center; margin-bottom: 2rem;">My Profile</h1>

	<div id="loading" class="loading-container">
		<div class="loader"></div>
		<p style="font-weight: 600; color: var(--bumble-text);">Loading your profile details...</p>
	</div>

	<div id="profile-content" style="display: none;">
		<div class="section-title">Profile & Panchang</div>
		<div class="dashboard-grid" id="profile-panchang">
			<!-- Injected here -->
		</div>

		<div id="bio-section" style="display: none; margin-bottom: 2rem;">
			<div class="section-title">About Me</div>
			<div class="info-card" style="padding: 1.25rem; border-radius: 16px;">
				<p id="bio-content" style="margin: 0; font-size: var(--font-sm); white-space: pre-wrap; color: var(--bumble-text); line-height: 1.5; font-weight: 500;"></p>
			</div>
		</div>

		<div class="section-title">Planetary Positions</div>
		<div style="overflow-x: auto; margin-bottom: 2.5rem;">
			<table class="compact-table" id="planets-table">
				<thead>
					<tr>
						<th>Planet</th>
						<th>Rasi</th>
						<th>Degree</th>
						<th>House</th>
					</tr>
				</thead>
				<tbody>
					<!-- Injected here -->
				</tbody>
			</table>
		</div>

		<div class="btn-group">
			<a href="/edit-profile" class="btn btn-sm">Edit My Profile</a>
			<!-- Reset button hidden for now, will be enabled in future -->
			<button id="resetProfileBtn" class="btn btn-sm btn-danger" style="display: none;">Reset My Profile</button>
		</div>
	</div>

	<div id="no-profile" style="display: none;" class="no-data">
		<p style="font-weight: 700; margin-bottom: 1.5rem; font-size: var(--font-lg);">We couldn't find your moonine - A Vedic Matchmaker profile.</p>
		<p style="margin-bottom: 1.5rem; color: var(--bumble-text-light);">Please share your birth details to get started!</p>
		<a href="/create-profile" class="btn">Create Profile</a>
	</div>

	<div id="error-state" style="display: none;" class="no-data">
		<p style="color: #ff4444; font-weight: 800; font-size: var(--font-lg); margin-bottom: 1rem;">Error loading profile.</p>
		<p style="color: var(--bumble-text-light);">We encountered a problem while loading your profile data. Please try again later.</p>
	</div>

	<script>
		import { getOrSetUserId, clearUserData, getCookie } from '../lib/user';
		import { resetUserProfile } from '../lib/api';
		import { calculateAstrology } from '../lib/astrology';

		window.addEventListener('load', async () => {
			const uid = getOrSetUserId();
			const stored = getCookie('user_details');

			if (!stored) {
				document.getElementById('loading')!.style.display = 'none';
				document.getElementById('no-profile')!.style.display = 'block';
				return;
			}

			const details = JSON.parse(stored);
			const resetBtn = document.getElementById('resetProfileBtn') as HTMLButtonElement;

			function formatTime12h(t24: string): string {
				if (!t24) return "";
				const [h24, m] = t24.split(':');
				let h = parseInt(h24);
				const ampm = h >= 12 ? 'PM' : 'AM';
				h = h % 12;
				if (h === 0) h = 12;
				return `${h.toString().padStart(2, '0')}:${m} ${ampm}`;
			}

			resetBtn?.addEventListener('click', async () => {
				if (confirm('Are you sure you want to reset your moonine - A Vedic Matchmaker profile? Please note that we do not keep your data after a reset. It will be permanently deleted from our systems as well as your local device.')) {
					if (uid) await resetUserProfile(uid);
					clearUserData();
					window.location.href = '/';
				}
			});

			try {
				const lat = details.lat ? parseFloat(details.lat) : 28.6139;
				const lon = details.lon ? parseFloat(details.lon) : 77.2090;
				const astroData = calculateAstrology(details.dob, details.tob, lat, lon);

				document.getElementById('loading')!.style.display = 'none';
				document.getElementById('profile-content')!.style.display = 'block';

				const infoGrid = document.getElementById('profile-panchang')!;
				const items = [
					{ label: 'User ID', value: uid },
					{ label: 'Name', value: details.name },
					{ label: 'Email', value: details.email },
					{ label: 'Phone', value: details.phone },
					{ label: 'Gender', value: details.gender ? (details.gender.charAt(0).toUpperCase() + details.gender.slice(1)) : 'N/A' },
					{ label: 'Marital Status', value: details.maritalStatus || 'N/A' },
					{ label: 'Born', value: `${details.dob} ${formatTime12h(details.tob)}` },
					{ label: 'Birth Location', value: details.location },
					{ label: 'Current Location', value: details.currentLocation || 'N/A' },
					{ label: 'Nakshatra', value: astroData.panchang.nakshatra },
					{ label: 'Moon Sign', value: astroData.panchang.moonSign },
					{ label: 'Day (Vara)', value: `${astroData.panchang.vara} (${astroData.panchang.varaLord})` },
					{ label: 'Tithi', value: astroData.panchang.tithi },
					{ label: 'Height', value: details.height || 'N/A' },
					{ label: 'Religion', value: details.religion || 'N/A' },
					{ label: 'Education', value: details.education || 'N/A' },
					{ label: 'Occupation', value: details.occupation || 'N/A' },
					{ label: 'Income', value: details.income || 'N/A' },
					{ label: 'Lagan Manglik', value: astroData.panchang.isLaganManglik ? 'Yes' : 'No' },
					{ label: 'Moon Manglik', value: astroData.panchang.isMoonManglik ? 'Yes' : 'No' }
				];

				infoGrid.innerHTML = items.map(i => {
					if (i.label === 'User ID') {
						return `
							<div class="info-card">
								<div class="info-item">
									<span class="info-label">${i.label}</span>
									<span class="info-value" style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
										<span>${i.value}</span>
										<button class="copy-uid-btn" data-uid="${i.value}" title="Copy User ID" style="background: var(--bumble-light-grey); border: 1.5px solid var(--bumble-border); padding: 0.2rem 0.5rem; margin: 0; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; color: var(--bumble-text-light); transition: all 0.2s; font-size: 11px; font-weight: 700; height: auto; width: auto; box-shadow: none; outline: none; vertical-align: middle;" onmouseover="this.style.color='var(--bumble-text)'; this.style.borderColor='var(--bumble-yellow)'" onmouseout="this.style.color='var(--bumble-text-light)'; this.style.borderColor='var(--bumble-border)'">
											<svg class="copy-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.25rem; display: block;">
												<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
												<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
											</svg>
											<span class="copied-text" style="display: none; font-size: 11px; font-weight: 800; color: #10b981; margin-right: 0.25rem;">Copied!</span>
											<span class="btn-text">Copy</span>
										</button>
									</span>
								</div>
							</div>
						`;
					}
					return `
						<div class="info-card">
							<div class="info-item">
								<span class="info-label">${i.label}</span>
								<span class="info-value">${i.value}</span>
							</div>
						</div>
					`;
				}).join('');

				const bioSection = document.getElementById('bio-section')!;
				const bioContent = document.getElementById('bio-content')!;
				if (details.bio) {
					bioSection.style.display = 'block';
					bioContent.textContent = details.bio;
				} else {
					bioSection.style.display = 'none';
				}

				const tbody = document.querySelector('#planets-table tbody')!;
				tbody.innerHTML = ''; // clear before appending
				astroData.planets.forEach(p => {
					const tr = document.createElement('tr');
					tr.innerHTML = `
						<td>${p.name}</td>
						<td>${p.rasi}</td>
						<td>${p.degree}</td>
						<td>${p.house}</td>
					`;
					tbody.appendChild(tr);
				});

			} catch (error) {
				console.error("Profile error:", error);
				document.getElementById('loading')!.style.display = 'none';
				document.getElementById('error-state')!.style.display = 'block';
			}
		});
	</script>
</Layout>
