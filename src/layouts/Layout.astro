---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style is:global>
			/* Base Styles */
			body {
				font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
				max-width: 900px;
				margin: 1rem auto;
				padding: 0 0.5rem;
				line-height: 1.4;
				background-color: #f8f9fa;
				font-size: 0.9rem;
			}
			.container {
				background: white;
				padding: 1rem 1.5rem;
				border-radius: 8px;
				box-shadow: 0 2px 12px rgba(0,0,0,0.05);
			}
			h1, h2 {
				color: #2c3e50;
				border-bottom: 2px solid #6c5ce7;
				padding-bottom: 0.3rem;
				margin-top: 0.5rem;
				margin-bottom: 0.5rem;
				font-size: 1.4rem;
			}

			/* Form & Buttons */
			form {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
				background: white;
				padding: 1rem;
				border-radius: 6px;
				border: 1px solid #e9ecef;
			}
			.form-row {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			@media (max-width: 600px) {
				.form-row {
					grid-template-columns: 1fr;
					gap: 0.75rem;
				}
			}
			.field {
				display: flex;
				flex-direction: column;
				position: relative;
			}
			label {
				font-weight: 600;
				margin-bottom: 0.2rem;
				color: #495057;
				font-size: 0.8rem;
			}
			input, select {
				padding: 0.4rem 0.6rem;
				border: 1px solid #ced4da;
				border-radius: 4px;
				font-size: 0.85rem;
				transition: border-color 0.15s ease-in-out;
			}
			input:focus, select:focus {
				border-color: #6c5ce7;
				outline: none;
				box-shadow: 0 0 0 2px rgba(108, 92, 231, 0.1);
			}
			button, .btn, .nav-link {
				padding: 0.5rem 1rem;
				background-color: #6c5ce7;
				color: white;
				border: none;
				border-radius: 4px;
				cursor: pointer;
				font-size: 0.9rem;
				text-decoration: none;
				display: inline-block;
				text-align: center;
				transition: all 0.2s;
			}
			button:hover, .btn:hover, .nav-link:hover {
				background-color: #5b4bc4;
			}
			.nav-link.active {
				background-color: #4834d4;
				box-shadow: inset 0 2px 4px rgba(0,0,0,0.2);
				transform: translateY(1px);
			}
			.btn-danger {
				background-color: #dc3545;
			}
			.btn-danger:hover {
				background-color: #c82333;
			}

			/* Match Card Styles (Global) */
			.matches-section {
				margin-top: 1.5rem;
			}
			.match-card {
				background: #fff;
				border: 1px solid #e9ecef;
				border-radius: 8px;
				padding: 1rem;
				margin-bottom: 0.75rem;
				transition: transform 0.2s, box-shadow 0.2s;
				box-shadow: 0 2px 5px rgba(0,0,0,0.03);
			}
			.match-card:hover {
				transform: translateY(-2px);
				box-shadow: 0 4px 8px rgba(0,0,0,0.08);
			}
			.match-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.4rem;
			}
			.match-name {
				font-size: 1.1rem;
				font-weight: bold;
				color: #2c3e50;
			}
			.match-category {
				background: #6c5ce7;
				color: white;
				padding: 0.15rem 0.6rem;
				border-radius: 12px;
				font-size: 0.75rem;
				font-weight: 600;
			}
			.match-score-container {
				margin: 0.6rem 0;
			}
			.match-score-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 2px;
			}
			.match-score-value {
				font-size: 1.2rem;
				font-weight: bold;
				color: #2c3e50;
			}
			.match-score-max {
				font-size: 0.7rem;
				color: #6c757d;
			}
			.match-percentage {
				font-size: 0.75rem;
				font-weight: 600;
			}
			.progress-bar-bg {
				background: #e9ecef;
				height: 6px;
				border-radius: 3px;
				overflow: hidden;
			}
			.progress-bar-fill {
				height: 100%;
				transition: width 0.5s ease-out;
			}
			.match-description {
				font-style: italic;
				color: #6c757d;
				font-size: 0.85rem;
				margin-bottom: 0.5rem;
			}
			.koota-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
				gap: 0.3rem;
				margin-top: 0.75rem;
			}
			.koota-item {
				font-size: 0.75rem;
				color: #495057;
				background: #f8f9fa;
				padding: 0.3rem;
				border-radius: 4px;
				text-align: center;
				cursor: help;
				position: relative;
				border: 1px solid #e9ecef;
			}
			.koota-item:hover .koota-explanation {
				display: block;
			}
			.koota-explanation {
				display: none;
				position: absolute;
				bottom: 100%;
				left: 50%;
				transform: translateX(-50%);
				background: #333;
				color: white;
				padding: 0.5rem;
				border-radius: 4px;
				width: 200px;
				z-index: 10;
				font-size: 0.75rem;
				text-align: left;
				box-shadow: 0 2px 5px rgba(0,0,0,0.2);
			}
		</style>
	</head>
	<body>
		<nav style="margin-bottom: 1rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
			<a href="/" class="nav-link" id="nav-home">Home</a>
			<a href="/dashboard" class="nav-link" id="nav-dashboard" style="display: none;">Dashboard</a>
		</nav>

		<div class="container">
			<slot />
		</div>

		<script>
			import { getCookie } from '../lib/user';

			function updateNavigation() {
				const userDetails = getCookie('user_details');
				const dashboardLink = document.getElementById('nav-dashboard');
				const currentPath = window.location.pathname;

				if (userDetails) {
					if (dashboardLink) dashboardLink.style.display = 'inline-block';
				}

				// Active Link Highlighting
				const links = document.querySelectorAll('.nav-link');
				links.forEach(link => {
					const href = link.getAttribute('href');
					if (href === currentPath || (href !== '/' && currentPath.startsWith(href))) {
						link.classList.add('active');
					} else if (href === '/' && currentPath === '/') {
						link.classList.add('active');
					}
				});
			}

			// Run on load and also handle potential cookie changes
			updateNavigation();

			// Optional: Re-check navigation if user details might have been updated
			window.addEventListener('storage', updateNavigation);
		</script>
	</body>
</html>