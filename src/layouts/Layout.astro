---
import SEO from '../components/SEO.astro';
import packageJson from '../../package.json';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<SEO title={title} description={description} noindex={noindex} />

		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CPZHQQLX6V"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-CPZHQQLX6V');
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400;1,700;1,900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
		<style is:global>
			*, *::before, *::after {
				box-sizing: border-box;
			}
			:root {
				--font-primary: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
				--font-secondary: 'Merriweather', serif;

				/* Bumble-inspired Palette - Strictly Light & Bright */
				--bumble-yellow: #ffcb37;
				--bumble-yellow-hover: #ffb800;
				--bumble-light-yellow: #fffaea;
				--bumble-cream: #faf8f2; /* Beautiful off-white cream background */
				--bumble-white: #ffffff;
				--bumble-light-grey: #f3f3f2;
				--bumble-border: #e8e6e1;
				--bumble-text: #4a3c31; /* Warm elegant dark brown/taupe instead of black */
				--bumble-text-light: #8f7663; /* Dark taupe accent */
				--bumble-accent: #ffcb37;

				--font-xs: 0.75rem;
				--font-sm: 0.85rem;
				--font-base: 0.95rem;
				--font-lg: 1.15rem;
				--font-xl: 1.35rem;
				--font-2xl: 1.6rem;
				--font-3xl: 2rem;
				--font-4xl: 3rem;
			}
			.logo {
				font-family: 'Dancing Script', cursive;
				font-size: clamp(2.5rem, 10vw, 6rem);
				font-weight: bold;
				margin-bottom: 0.5rem;
				line-height: 1;
				display: inline-block;
				transform: rotate(-3deg);
				position: relative;
				z-index: 1;
				color: var(--bumble-yellow);
				text-shadow: 2px 2px 0px rgba(143, 118, 99, 0.15);
			}
			.logo-sm {
				font-size: clamp(2rem, 7vw, 4rem);
				margin-bottom: 0;
			}
			#nav-loader {
				position: fixed;
				top: 0;
				left: 0;
				height: 3px;
				width: 0%;
				background-color: #8f7663; /* Required dark taupe by memory */
				z-index: 10000;
				transition: width 0.3s ease-out, opacity 0.3s ease-in;
				box-shadow: 0 1px 3px rgba(143, 118, 99, 0.4);
			}
			.site-header {
				position: relative;
				margin-bottom: 2rem;
				padding-top: 1rem;
				display: flex;
				justify-content: center;
				align-items: center;
				width: 100%;
			}
			.user-counter {
				position: absolute;
				right: 0.5rem;
				top: 0.5rem;
				font-size: var(--font-xs);
				color: var(--bumble-text);
				line-height: 1.8;
				background: var(--bumble-yellow);
				padding: 0.2rem 0.75rem;
				border-radius: 9999px;
				border: 1.5px solid var(--bumble-yellow);
				display: none;
				font-weight: bold;
			}
			.user-counter strong {
				color: var(--bumble-text);
			}
			.site-nav {
				display: inline-flex;
				gap: 0.35rem;
				flex-wrap: wrap;
				justify-content: center;
				align-items: center;
				background: var(--bumble-white);
				padding: 0.35rem 0.6rem;
				border-radius: 9999px;
				box-shadow: 0 2px 10px rgba(143,118,99,0.05);
				border: 1px solid var(--bumble-border);
				max-width: 100%;
				margin: 0 auto;
			}
			/* Base Styles */
			html {
				font-size: 16px;
				background-color: var(--bumble-cream);
			}
			body {
				font-family: var(--font-primary);
				font-size: var(--font-base);
				max-width: 800px;
				margin: 1rem auto;
				padding: 0 0.75rem;
				line-height: 1.5;
				background-color: var(--bumble-cream);
				color: var(--bumble-text);
			}
			.container {
				background: white;
				padding: 1.75rem 2rem;
				border-radius: 20px;
				box-shadow: 0 4px 20px rgba(143,118,99,0.04);
				border: 1px solid var(--bumble-border);
			}
			h1 {
				color: var(--bumble-text);
				border-bottom: 2px solid var(--bumble-yellow);
				padding-bottom: 0.4rem;
				margin-top: 0.5rem;
				margin-bottom: 1rem;
				font-size: var(--font-2xl);
				font-weight: 800;
				letter-spacing: -0.02em;
			}
			h2 {
				color: var(--bumble-text);
				border-bottom: 2px solid var(--bumble-yellow);
				padding-bottom: 0.35rem;
				margin-top: 0.5rem;
				margin-bottom: 1rem;
				font-size: var(--font-xl);
				font-weight: 800;
				letter-spacing: -0.01em;
			}

			/* Form & Buttons */
			form {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				background: var(--bumble-light-grey);
				padding: 1.5rem;
				border-radius: 18px;
				border: none;
			}
			.form-row {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			@media (max-width: 600px) {
				.form-row {
					grid-template-columns: 1fr;
					gap: 1rem;
				}
				.container {
					padding: 1rem 1.25rem;
				}
			}
			.field {
				display: flex;
				flex-direction: column;
				position: relative;
			}
			label {
				font-weight: 700;
				margin-bottom: 0.4rem;
				color: var(--bumble-text);
				font-size: var(--font-xs);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			input, select, textarea {
				width: 100%;
				padding: 0.75rem 1rem;
				border: 2px solid var(--bumble-border);
				border-radius: 12px;
				font-size: var(--font-base);
				transition: all 0.2s ease-in-out;
				background-color: #fff;
				color: var(--bumble-text);
				font-weight: 500;
				min-height: 44px;
			}
			input:focus, select:focus, textarea:focus {
				border-color: var(--bumble-yellow);
				outline: none;
				box-shadow: 0 0 0 3px rgba(255, 203, 55, 0.25);
			}
			button, .btn, .nav-link {
				padding: 0.5rem 1.25rem;
				background-color: var(--bumble-yellow);
				color: var(--bumble-text);
				border: none;
				border-radius: 9999px;
				cursor: pointer;
				font-size: var(--font-sm);
				font-weight: 700;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				text-align: center;
				transition: all 0.2s ease;
				min-height: 44px;
				line-height: 1;
				box-sizing: border-box;
			}
			button:hover, .btn:hover {
				background-color: var(--bumble-yellow-hover);
			}
			.nav-link {
				background-color: transparent;
				color: var(--bumble-text-light);
				padding: 0.5rem 1rem;
				white-space: nowrap;
			}
			.nav-link:hover {
				color: var(--bumble-text);
				background-color: rgba(143,118,99,0.05);
			}
			.nav-link.active {
				background-color: var(--bumble-yellow);
				color: var(--bumble-text);
				box-shadow: 0 2px 8px rgba(255, 203, 55, 0.3);
			}

			@media (max-width: 600px) {
				.site-nav {
					border-radius: 20px;
					padding: 0.35rem 0.4rem;
					gap: 0.25rem;
				}
				.nav-link {
					padding: 0.4rem 0.75rem;
					font-size: var(--font-xs);
					min-height: 38px;
				}
			}
			.btn-danger {
				background-color: #ff4444;
				color: white;
			}
			.btn-danger:hover {
				background-color: #e03333;
			}

			/* Match Card Styles (Global Overhaul for Bumble Card Layout) */
			.matches-section {
				margin-top: 1.5rem;
			}
			.match-card {
				background: #fff;
				border: 2px solid var(--bumble-border);
				border-radius: 20px;
				padding: 1.5rem;
				margin-bottom: 1.5rem;
				box-shadow: 0 6px 18px rgba(143,118,99,0.04);
				transition: all 0.2s ease;
				overflow: hidden;
				position: relative;
			}
			.match-card:hover {
				border-color: var(--bumble-yellow);
			}
			.flash-border-active {
				border-color: var(--bumble-yellow) !important;
				box-shadow: 0 0 0 4px rgba(255, 203, 55, 0.4) !important;
			}
			.match-header {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				margin-bottom: 1rem;
			}
			.match-name {
				font-size: var(--font-xl);
				font-weight: 800;
				color: var(--bumble-text);
				letter-spacing: -0.02em;
			}
			.match-category {
				background: var(--bumble-yellow);
				color: var(--bumble-text);
				padding: 0.25rem 0.75rem;
				border-radius: 9999px;
				font-size: var(--font-xs);
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				border: 1.5px solid var(--bumble-yellow);
			}
			.match-score-container {
				margin: 1rem 0;
				background: var(--bumble-light-grey);
				padding: 0.75rem 1rem;
				border-radius: 12px;
			}
			.match-score-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 0.4rem;
			}
			.match-score-value {
				font-size: var(--font-lg);
				font-weight: 800;
				color: var(--bumble-text);
			}
			.match-score-max {
				font-size: var(--font-xs);
				color: var(--bumble-text-light);
			}
			.match-percentage {
				font-size: var(--font-sm);
				font-weight: 800;
			}
			.progress-bar-bg {
				background: #e4e4e2;
				height: 8px;
				border-radius: 9999px;
				overflow: hidden;
			}
			.progress-bar-fill {
				height: 100%;
				transition: width 0.5s ease-out;
			}
			.match-description {
				color: var(--bumble-text);
				font-size: var(--font-sm);
				margin-bottom: 1rem;
				line-height: 1.5;
				font-weight: 500;
			}
			.match-highlight {
				display: flex;
				align-items: flex-start;
				gap: 0.75rem;
				padding: 1rem;
				border-radius: 14px;
				margin-bottom: 1rem;
			}
			.match-highlight-icon {
				font-size: 1.75rem;
				line-height: 1;
			}
			.match-highlight-content {
				font-size: var(--font-sm);
				color: var(--bumble-text);
				line-height: 1.4;
			}
			.match-highlight-title {
				font-weight: 800;
				margin-bottom: 0.25rem;
				display: block;
				font-size: var(--font-sm);
				text-transform: uppercase;
				letter-spacing: 0.02em;
			}
			.koota-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 0.4rem;
				margin-top: 0.75rem;
			}
			@media (max-width: 500px) {
				.koota-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			/* Mobile Bottom Navigation Bar */
			.mobile-bottom-nav {
				display: none;
			}
			@media (max-width: 768px) {
				body {
					padding-bottom: 70px;
				}
				.mobile-bottom-nav {
					display: flex;
					position: fixed;
					bottom: 0;
					left: 0;
					right: 0;
					background: var(--bumble-white);
					border-top: 2px solid var(--bumble-border);
					padding: 0.4rem 0.5rem;
					justify-content: space-evenly;
					align-items: center;
					z-index: 999;
					box-shadow: 0 -4px 16px rgba(143,118,99,0.08);
				}
				.mobile-nav-item {
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
					gap: 0.2rem;
					color: var(--bumble-text-light);
					text-decoration: none;
					font-size: var(--font-xs);
					font-weight: 700;
					flex: 1 1 0px;
					max-width: 90px;
					padding: 0.35rem 0.25rem;
					border-radius: 12px;
					transition: all 0.2s ease;
					text-align: center;
				}
				.mobile-nav-item.active, .mobile-nav-item:hover {
					color: var(--bumble-text);
				}
				.mobile-nav-item.active {
					background-color: var(--bumble-light-yellow);
				}
				.mobile-nav-item svg {
					stroke: currentColor;
					flex-shrink: 0;
				}
				.mobile-nav-item.active svg {
					stroke: var(--bumble-text);
					fill: var(--bumble-yellow);
				}
			}
			.koota-item {
				font-size: var(--font-xs);
				color: var(--bumble-text);
				background: var(--bumble-cream);
				padding: 0.5rem;
				border-radius: 8px;
				text-align: center;
				border: 1px solid var(--bumble-border);
				font-weight: 600;
			}
			.koota-explanation {
				display: block;
				margin-top: 0.25rem;
				color: var(--bumble-text-light);
				font-size: var(--font-xs);
				text-align: left;
				border-top: 1px solid var(--bumble-border);
				padding-top: 0.25rem;
			}
		</style>
	</head>
	<body>
		<div id="nav-loader"></div>
		<header class="site-header">
			<nav class="site-nav">
				<a href="/" class="nav-link" id="nav-home">Home</a>
				<a href="/dashboard" class="nav-link" id="nav-dashboard" style="display: none;">Matches</a>
				<a href="/profile" class="nav-link" id="nav-profile" style="display: none;">My Profile</a>
				<a href="/about" class="nav-link" id="nav-guide">About</a>
				<a href="/login" class="nav-link" id="nav-login">Log In</a>
				<a href="#" class="nav-link" id="nav-logout" style="display: none;">Log Out</a>
			</nav>
		</header>

		<div class="container">
			<slot />
		</div>

		<!-- Mobile Bottom Bar -->
		<nav class="mobile-bottom-nav" aria-label="Mobile Bottom Navigation">
			<a href="/" class="mobile-nav-item" id="mobile-nav-home">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
					<polyline points="9 22 9 12 15 12 15 22"></polyline>
				</svg>
				<span>Home</span>
			</a>
			<a href="/dashboard" class="mobile-nav-item" id="mobile-nav-dashboard" style="display: none;">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="3" width="7" height="7"></rect>
					<rect x="14" y="3" width="7" height="7"></rect>
					<rect x="14" y="14" width="7" height="7"></rect>
					<rect x="3" y="14" width="7" height="7"></rect>
				</svg>
				<span>Matches</span>
			</a>
			<a href="/profile" class="mobile-nav-item" id="mobile-nav-profile" style="display: none;">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
					<circle cx="12" cy="7" r="4"></circle>
				</svg>
				<span>Profile</span>
			</a>
			<a href="/login" class="mobile-nav-item" id="mobile-nav-login">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
					<polyline points="10 17 15 12 10 7"></polyline>
					<line x1="15" y1="12" x2="3" y2="12"></line>
				</svg>
				<span>Log In</span>
			</a>
		</nav>

		<footer style="margin-top: 3rem; font-size: var(--font-xs); color: var(--bumble-text-light); text-align: center; border-top: 1px solid var(--bumble-border); padding-top: 2rem; position: relative;">
			<div class="user-counter" style="position: absolute; top: 1.5rem; right: 0;">
				<strong id="total-users-count">...</strong>
			</div>
			<p style="margin-bottom: 0.75rem; color: var(--bumble-text); font-weight: 700; font-size: var(--font-sm);">
				To get contact details, send the <b>User ID</b> of the person to <a href="mailto:rahulbaliastrology@gmail.com" style="color: var(--bumble-text-light); text-decoration: underline; font-weight: 800;">rahulbaliastrology@gmail.com</a>.
			</p>
			<p style="margin-bottom: 1rem; font-weight: 500;">
				&copy; {new Date().getFullYear()} moonine - A Vedic Matchmaker v{packageJson.version}.
			</p>
			<p style="margin-top: 0.5rem; font-size: 0.75rem; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
				<a href="/guna-milan" style="color: var(--bumble-text); text-decoration: underline; font-weight: 700;">Guna Milan</a>
				<a href="/privacy" style="color: var(--bumble-text); text-decoration: underline; font-weight: 700;">Privacy Policy</a>
				<a href="/terms" style="color: var(--bumble-text); text-decoration: underline; font-weight: 700;">Terms of Service</a>
				<a href="https://forms.gle/48T3MwV6LD7yPyed9" target="_blank" style="color: var(--bumble-text); text-decoration: underline; font-weight: 700;">Feature Request</a>
			</p>
			<p style="margin-top: 0.5rem; font-size: 0.75rem;">
				Location data &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" style="color: var(--bumble-text-light);">OpenStreetMap</a> contributors.
			</p>
		</footer>

		<script>
			import { getCookie, clearUserData } from '../lib/user';
			import { fetchUserCount } from '../lib/api';

			function updateNavigation() {
				const userDetails = getCookie('user_details');
				const dashboardLink = document.getElementById('nav-dashboard');
				const profileLink = document.getElementById('nav-profile');
				const loginLink = document.getElementById('nav-login');
				const logoutLink = document.getElementById('nav-logout');
				const currentPath = window.location.pathname;

				const mDashboardLink = document.getElementById('mobile-nav-dashboard');
				const mProfileLink = document.getElementById('mobile-nav-profile');
				const mLoginLink = document.getElementById('mobile-nav-login');

				if (userDetails) {
					if (dashboardLink) dashboardLink.style.display = 'inline-flex';
					if (profileLink) profileLink.style.display = 'inline-flex';
					if (loginLink) loginLink.style.display = 'none';
					if (logoutLink) logoutLink.style.display = 'inline-flex';

					if (mDashboardLink) mDashboardLink.style.display = 'flex';
					if (mProfileLink) mProfileLink.style.display = 'flex';
					if (mLoginLink) mLoginLink.style.display = 'none';
				} else {
					if (dashboardLink) dashboardLink.style.display = 'none';
					if (profileLink) profileLink.style.display = 'none';
					if (loginLink) loginLink.style.display = 'inline-flex';
					if (logoutLink) logoutLink.style.display = 'none';

					if (mDashboardLink) mDashboardLink.style.display = 'none';
					if (mProfileLink) mProfileLink.style.display = 'none';
					if (mLoginLink) mLoginLink.style.display = 'flex';
				}

				// Active Link Highlighting
				const links = document.querySelectorAll('.nav-link, .mobile-nav-item');
				links.forEach(link => {
					const href = link.getAttribute('href');
					if (href === currentPath || (href && href !== '/' && currentPath.startsWith(href))) {
						link.classList.add('active');
					} else if (href === '/' && currentPath === '/') {
						link.classList.add('active');
					} else {
						link.classList.remove('active');
					}
				});
			}

			// Run on load and also handle potential cookie changes
			updateNavigation();

			// Log Out click event handler
			const logoutBtn = document.getElementById('nav-logout');
			if (logoutBtn) {
				logoutBtn.addEventListener('click', (e) => {
					e.preventDefault();
					clearUserData();
					window.location.href = '/';
				});
			}

			async function updateTotalUsers() {
				const CACHE_KEY = 'total_users_count';
				const CACHE_TIME_KEY = 'total_users_count_timestamp';
				const ONE_DAY = 24 * 60 * 60 * 1000;

				const countEl = document.getElementById('total-users-count');
				const userCounterContainer = document.querySelector('.user-counter') as HTMLElement;
				const cachedCount = localStorage.getItem(CACHE_KEY);
				const cachedTimestamp = localStorage.getItem(CACHE_TIME_KEY);
				const now = Date.now();

				if (cachedCount && cachedTimestamp) {
					if (countEl) countEl.textContent = cachedCount;
					if (userCounterContainer && parseInt(cachedCount) >= 1000) {
						userCounterContainer.style.display = 'block';
					}
					if (now - parseInt(cachedTimestamp) < ONE_DAY) {
						return;
					}
				}

				try {
					const count = await fetchUserCount();
					if (countEl) countEl.textContent = count.toString();
					if (userCounterContainer && count >= 1000) {
						userCounterContainer.style.display = 'block';
					} else if (userCounterContainer) {
						userCounterContainer.style.display = 'none';
					}
					localStorage.setItem(CACHE_KEY, count.toString());
					localStorage.setItem(CACHE_TIME_KEY, now.toString());
				} catch (err) {
					console.error('Failed to fetch total users:', err);
				}
			}

			// Fully lazy and non-blocking initialization
			const initTotalUsers = () => {
				if ('requestIdleCallback' in window) {
					(window as any).requestIdleCallback(() => updateTotalUsers(), { timeout: 2000 });
				} else {
					setTimeout(updateTotalUsers, 2000);
				}
			};

			if (document.readyState === 'complete') {
				initTotalUsers();
			} else {
				window.addEventListener('load', initTotalUsers);
			}

			// Global Copy User ID Logic
			document.addEventListener('click', async (e) => {
				const uidButton = (e.target as HTMLElement).closest('.copy-uid-btn') as HTMLButtonElement | null;
				if (uidButton) {
					const uid = uidButton.getAttribute('data-uid');
					if (!uid) return;

					try {
						await navigator.clipboard.writeText(uid);

						const copyIcon = uidButton.querySelector('.copy-icon') as HTMLElement | null;
						const copiedText = uidButton.querySelector('.copied-text') as HTMLElement | null;
						const btnText = uidButton.querySelector('.btn-text') as HTMLElement | null;

						if (copiedText) {
							if (copyIcon) copyIcon.style.display = 'none';
							if (btnText) btnText.style.display = 'none';
							copiedText.style.display = 'inline';

							const originalColor = uidButton.style.color;
							const originalBorderColor = uidButton.style.borderColor;
							uidButton.style.color = '#10b981';
							uidButton.style.borderColor = '#10b981';

							const container = uidButton.closest('.info-card') || uidButton.closest('.match-card');
							if (container) {
								container.classList.add('flash-border-active');
							}

							setTimeout(() => {
								if (copyIcon) copyIcon.style.display = 'block';
								if (btnText) btnText.style.display = 'inline';
								copiedText.style.display = 'none';
								uidButton.style.color = originalColor;
								uidButton.style.borderColor = originalBorderColor;

								if (container) {
									container.classList.remove('flash-border-active');
								}
							}, 1500);
						}
					} catch (err) {
						console.error('Failed to copy User ID:', err);
					}
					return;
				}

				// Global Copy Match Summary Logic
				const matchButton = (e.target as HTMLElement).closest('.copy-match-btn') as HTMLButtonElement | null;
				if (matchButton) {
					const name = matchButton.getAttribute('data-name');
					const uid = matchButton.getAttribute('data-uid');
					const score = matchButton.getAttribute('data-score');
					const category = matchButton.getAttribute('data-category');

					const textToCopy = `🌙 Guna Milan Match via moonine\n----------------------------------\nMatch: ${name} (User ID: ${uid})\nCompatibility Score: ${score} / 36 Points (${category})\nDiscover aligned matches on moonine: https://moonine.netlify.app/\n----------------------------------`;

					try {
						await navigator.clipboard.writeText(textToCopy);
						const labelEl = matchButton.querySelector('.copy-match-text') as HTMLElement | null;
						if (labelEl) {
							const originalText = labelEl.textContent;
							labelEl.textContent = 'Copied Summary!';
							matchButton.style.borderColor = '#10b981';
							matchButton.style.color = '#10b981';

							setTimeout(() => {
								labelEl.textContent = originalText;
								matchButton.style.borderColor = 'var(--bumble-border)';
								matchButton.style.color = 'var(--bumble-text)';
							}, 1500);
						}
					} catch (err) {
						console.error('Failed to copy match summary:', err);
					}
				}
			});

			// Optional: Re-check navigation if user details might have been updated
			window.addEventListener('storage', updateNavigation);

			// Navigation Loader Logic
			const navLoader = document.getElementById('nav-loader');
			if (navLoader) {
				document.addEventListener('click', (e) => {
					const target = e.target as HTMLElement;
					const link = target.closest('a');

					if (link && link.href && link.href.startsWith(window.location.origin) && !link.href.includes('#') && link.target !== '_blank') {
						if (link.href !== window.location.href) {
							navLoader.style.opacity = '1';
							navLoader.style.width = '80%';
						}
					}
				});

				// Reset on load/pageshow (needed for bfcache)
				window.addEventListener('pageshow', () => {
					navLoader.style.width = '100%';
					setTimeout(() => {
						navLoader.style.opacity = '0';
						setTimeout(() => {
							navLoader.style.width = '0%';
						}, 300);
					}, 200);
				});
			}
		</script>
	</body>
</html>
