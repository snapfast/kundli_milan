---
interface Props {
	isEdit?: boolean;
}

const { isEdit = false } = Astro.props;
---

<style>
	#suggestions, #currentSuggestions {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background: white;
		border: 2px solid var(--bumble-yellow);
		border-top: none;
		z-index: 1000;
		max-height: 200px;
		overflow-y: auto;
		display: none;
		border-radius: 0 0 12px 12px;
		box-shadow: 0 8px 16px rgba(143,118,99,0.06);
	}
	.suggestion-item {
		padding: 0.75rem 1rem;
		cursor: pointer;
		border-bottom: 1px solid var(--bumble-light-grey);
		color: var(--bumble-text);
		font-weight: 500;
		font-size: var(--font-sm);
	}
	.suggestion-item:hover {
		background-color: var(--bumble-cream);
	}
	.suggestion-item:last-child {
		border-bottom: none;
		border-radius: 0 0 10px 10px;
	}
	footer {
		margin-top: 2rem;
		font-size: var(--font-xs);
		color: var(--bumble-text-light);
		text-align: center;
	}
	.form-actions {
		display: flex;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
	.btn-submit {
		flex: 2;
		background-color: var(--bumble-yellow);
		color: var(--bumble-text);
		font-weight: 800;
		border: 2px solid var(--bumble-yellow);
	}
	.btn-reset {
		flex: 1;
		background-color: var(--bumble-light-grey);
		color: var(--bumble-text);
		font-weight: 700;
		border: 2px solid transparent;
	}
	.btn-reset:hover {
		background-color: #e4e4e2;
	}

	/* Elegant Radio/Select Tiles for Gender & Preferences to match Left Phone Screen */
	.gender-selector-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
		margin-top: 0.5rem;
		margin-bottom: 0.5rem;
	}
	.gender-tile {
		border: 2px solid var(--bumble-border);
		border-radius: 16px;
		padding: 1rem 0.5rem;
		text-align: center;
		cursor: pointer;
		transition: all 0.2s ease;
		background: white;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		color: var(--bumble-text);
	}
	.gender-tile:hover {
		border-color: var(--bumble-yellow);
		background-color: var(--bumble-cream);
	}
	.gender-tile.selected {
		border-color: var(--bumble-yellow);
		background-color: var(--bumble-yellow);
		color: var(--bumble-text);
		box-shadow: 0 4px 12px rgba(255, 203, 55, 0.2);
	}
	.gender-tile.selected .gender-icon {
		color: var(--bumble-text);
	}
	.gender-icon {
		font-size: 1.75rem;
		line-height: 1;
	}
	.gender-label {
		font-size: var(--font-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.gender-tile:focus-within {
		border-color: var(--bumble-yellow);
		box-shadow: 0 0 0 3px rgba(255, 203, 55, 0.4);
		outline: none;
	}
	.gender-tile input[type="radio"] {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		border: 0;
	}
	.gender-tile:focus-within {
		border-color: var(--bumble-yellow);
		outline: none;
		box-shadow: 0 0 0 4px rgba(255, 203, 55, 0.4);
	}
</style>

<h1 id="page-title" style="font-family: var(--font-secondary); font-size: var(--font-2xl); border-bottom: none; text-align: center; margin-bottom: 2rem;">{isEdit ? 'Edit Your Profile' : 'Create Your Profile'}</h1>
<div id="form-error-message" style="display: none; background-color: #fef2f2; border: 2px solid #ff4444; color: #b91c1c; padding: 1rem; border-radius: 12px; margin-bottom: 1.5rem; font-size: var(--font-sm); text-align: center; font-weight: 600;"></div>

{isEdit ? (
	/* EDIT PROFILE FORM */
	<form id="detailsForm" data-is-edit="true" novalidate style="background: white; border: 2px solid var(--bumble-border); border-radius: 24px; padding: 2rem; box-shadow: 0 8px 24px rgba(143,118,99,0.02);">
		<div id="step1" class="form-step">
			<h2 style="text-align: center; font-size: var(--font-lg); margin-bottom: 2rem; border-bottom: 2px solid var(--bumble-yellow); font-family: var(--font-secondary); color: var(--bumble-text); padding-bottom: 0.5rem;">Stage 1: Basic Details</h2>
			<div class="form-row">
				<div class="field">
					<label for="name">Full Name</label>
					<input type="text" id="name" name="name" required minlength="2" maxlength="50" placeholder="Enter your full name" />
				</div>
				<div class="field">
					<label for="email">Email Address</label>
					<input type="email" id="email" name="email" required placeholder="your.email@example.com" />
				</div>
			</div>
			<div class="form-row" style="margin-top: 1rem;">
				<div class="field">
					<label for="dob">Date of Birth</label>
					<input type="date" id="dob" name="dob" required max={new Date().toISOString().split('T')[0]} />
				</div>
				<div class="field">
					<label for="tob">Time of Birth</label>
					<input type="time" id="tob" name="tob" required style="width: 100%;" />
				</div>
			</div>
			<div class="form-row" style="margin-top: 1rem;">
				<div class="field" style="grid-column: span 2;">
					<label>Gender</label>
					<div class="gender-selector-grid">
						<label class="gender-tile" id="tile-male">
							<span class="gender-icon" style="display: inline-flex; align-items: center; justify-content: center;">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="10" cy="14" r="5"></circle>
									<polyline points="15 3 21 3 21 9"></polyline>
									<line x1="21" y1="3" x2="13.5" y2="10.5"></line>
								</svg>
							</span>
							<span class="gender-label">Male</span>
							<input type="radio" name="gender" value="male" />
						</label>
						<label class="gender-tile" id="tile-female">
							<span class="gender-icon" style="display: inline-flex; align-items: center; justify-content: center;">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="9" r="5"></circle>
									<line x1="12" y1="14" x2="12" y2="21"></line>
									<line x1="9" y1="18" x2="15" y2="18"></line>
								</svg>
							</span>
							<span class="gender-label">Female</span>
							<input type="radio" name="gender" value="female" />
						</label>
						<label class="gender-tile" id="tile-other">
							<span class="gender-icon" style="display: inline-flex; align-items: center; justify-content: center;">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="4"></circle>
									<line x1="12" y1="16" x2="12" y2="22"></line>
									<line x1="9" y1="19" x2="15" y2="19"></line>
									<polyline points="16 4 20 4 20 8"></polyline>
									<line x1="20" y1="4" x2="15" y2="9"></line>
								</svg>
							</span>
							<span class="gender-label">Other</span>
							<input type="radio" name="gender" value="other" />
						</label>
					</div>
				</div>
			</div>
			<div class="form-row" style="margin-top: 1rem;">
				<div class="field" style="grid-column: span 2;">
					<label for="location">Birth Location (City, Country)</label>
					<input type="text" id="location" name="location" required placeholder="e.g. New Delhi, India" autocomplete="off" />
					<div id="suggestions"></div>
					<input type="hidden" id="lat" name="lat" />
					<input type="hidden" id="lon" name="lon" />
				</div>
			</div>
			<div class="form-row" style="margin-top: 1rem;">
				<div class="field">
					<label for="phone">Mobile Number</label>
					<input type="tel" id="phone" name="phone" readonly style="background-color: var(--bumble-light-grey); cursor: not-allowed; color: var(--bumble-text-light);" />
				</div>
				<div class="field">
					<label for="pin">4-digit PIN</label>
					<input type="password" id="pin" name="pin" required pattern="[0-9]{4}" placeholder="Enter 4-digit PIN to update" maxlength="4" inputmode="numeric" />
				</div>
			</div>
			<div class="form-actions" style="margin-top: 2rem;">
				<button type="button" class="btn btn-submit" id="next1Btn">Next</button>
				<button type="button" class="btn btn-reset cancelBtn">Cancel</button>
			</div>
		</div>

		<div id="step2" class="form-step" style="display: none;">
			<h2 style="text-align: center; font-size: var(--font-lg); margin-bottom: 2rem; border-bottom: 2px solid var(--bumble-yellow); font-family: var(--font-secondary); color: var(--bumble-text); padding-bottom: 0.5rem;">Stage 2: Additional Details</h2>
			<div class="form-row">
				<div class="field" style="grid-column: span 2;">
					<label for="height">Height (Optional)</label>
					<input type="text" id="height" name="height" placeholder="e.g. 5'8'' or 173 cm" />
				</div>
			</div>
			<div class="form-row" style="margin-top: 1rem;">
				<div class="field">
					<label for="currentLocation">Current Location (Optional)</label>
					<input type="text" id="currentLocation" name="currentLocation" placeholder="e.g. Mumbai, India" autocomplete="off" />
					<div id="currentSuggestions"></div>
					<input type="hidden" id="currentLat" name="currentLat" />
					<input type="hidden" id="currentLon" name="currentLon" />
				</div>
				<div class="field">
					<label for="religion">Religion / Community (Optional)</label>
					<input type="text" id="religion" name="religion" placeholder="e.g. Hindu, Brahmin" />
				</div>
			</div>
			<div class="form-row" style="margin-top: 1rem;">
				<div class="field">
					<label for="education">Education (Optional)</label>
					<input type="text" id="education" name="education" placeholder="e.g. B.Tech, MBA" />
				</div>
				<div class="field">
					<label for="occupation">Occupation (Optional)</label>
					<input type="text" id="occupation" name="occupation" placeholder="e.g. Software Engineer" />
				</div>
			</div>
			<div class="form-row" style="margin-top: 1rem;">
				<div class="field" style="grid-column: span 2;">
					<label for="income">Annual Income (Optional)</label>
					<input type="text" id="income" name="income" placeholder="e.g. 15 LPA" />
				</div>
			</div>
			<div class="form-row" style="margin-top: 1rem;">
				<div class="field" style="grid-column: span 2;">
					<label for="bio">About Me / Bio (Optional)</label>
					<textarea id="bio" name="bio" rows="3" class="bio-textarea" placeholder="Tell us a bit about yourself..." style="border-radius: 12px;"></textarea>
				</div>
			</div>

			<p style="font-size: var(--font-xs); color: var(--bumble-text-light); text-align: center; margin-top: 1.5rem; margin-bottom: 0.5rem; font-weight: 500;">By submitting your details, you agree to our <a href="/terms" style="color: var(--bumble-text); text-decoration: underline; font-weight: 700;">Terms of Service</a>.</p>

			<div class="form-actions">
				<button type="button" class="btn btn-reset" id="prev1Btn">Previous</button>
				<button type="submit" class="btn btn-submit" id="submitBtn">Update Details</button>
				<button type="button" class="btn btn-reset cancelBtn">Cancel</button>
			</div>
		</div>
	</form>
) : (
	/* SIGNUP FORM */
	<form id="detailsForm" data-is-edit="false" novalidate style="background: white; border: 2px solid var(--bumble-border); border-radius: 24px; padding: 2rem; box-shadow: 0 8px 24px rgba(143,118,99,0.02);">
		<div id="step1" class="form-step">
			<h2 style="text-align: center; font-size: var(--font-lg); margin-bottom: 2rem; border-bottom: 2px solid var(--bumble-yellow); font-family: var(--font-secondary); color: var(--bumble-text); padding-bottom: 0.5rem;">Stage 1: Account Setup</h2>
			<div class="form-row">
				<div class="field">
					<label for="phone">Mobile Number</label>
					<input type="tel" id="phone" name="phone" required pattern="[0-9]{10}" placeholder="Enter 10-digit mobile number" maxlength="10" />
				</div>
				<div class="field">
					<label for="pin">4-digit PIN</label>
					<input type="password" id="pin" name="pin" required pattern="[0-9]{4}" placeholder="Enter 4-digit PIN" maxlength="4" inputmode="numeric" />
				</div>
			</div>
			<div class="field-privacy-note" style="margin-top: 1rem; background-color: var(--bumble-light-yellow); border: 1.5px solid var(--bumble-yellow); padding: 0.75rem 1rem; border-radius: 12px; font-size: var(--font-xs); color: var(--bumble-text); line-height: 1.4; display: flex; gap: 0.5rem; align-items: flex-start; font-weight: 500;">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 0.1rem; color: var(--bumble-text-light);">
					<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
					<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
				</svg>
				<span><strong>100% Private & Secure:</strong> Your mobile number is confidential and strictly used for secure, PIN-based logins. It will <strong>never</strong> be shared with other users, shown publicly on your profile, or used for spam.</span>
			</div>
			<div class="form-actions" style="margin-top: 2rem;">
				<button type="button" class="btn btn-submit" id="next1Btn" style="width: 100%;">Next</button>
			</div>
			<p style="text-align: center; margin-top: 2rem; font-size: var(--font-sm); font-weight: 500; color: var(--bumble-text-light);">
				Already have an account? <a href="/login" style="color: var(--bumble-text); font-weight: 700; text-decoration: underline;">Log In</a>
			</p>
		</div>

		<div id="step2" class="form-step" style="display: none;">
			<h2 style="text-align: center; font-size: var(--font-lg); margin-bottom: 2rem; border-bottom: 2px solid var(--bumble-yellow); font-family: var(--font-secondary); color: var(--bumble-text); padding-bottom: 0.5rem;">Stage 2: Basic Details</h2>
			<div class="form-row">
				<div class="field">
					<label for="name">Full Name</label>
					<input type="text" id="name" name="name" required minlength="2" maxlength="50" placeholder="Enter your full name" />
				</div>
				<div class="field">
					<label for="email">Email Address</label>
					<input type="email" id="email" name="email" required placeholder="your.email@example.com" />
				</div>
			</div>
			<div class="form-row" style="margin-top: 1rem;">
				<div class="field">
					<label for="dob">Date of Birth</label>
					<input type="date" id="dob" name="dob" required max={new Date().toISOString().split('T')[0]} />
				</div>
				<div class="field">
					<label for="tob">Time of Birth</label>
					<input type="time" id="tob" name="tob" required style="width: 100%;" />
				</div>
			</div>
			<div class="form-row" style="margin-top: 1rem;">
				<div class="field" style="grid-column: span 2;">
					<label>Gender</label>
					<div class="gender-selector-grid">
						<label class="gender-tile" id="tile-male">
							<span class="gender-icon" style="display: inline-flex; align-items: center; justify-content: center;">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="10" cy="14" r="5"></circle>
									<polyline points="15 3 21 3 21 9"></polyline>
									<line x1="21" y1="3" x2="13.5" y2="10.5"></line>
								</svg>
							</span>
							<span class="gender-label">Male</span>
							<input type="radio" name="gender" value="male" />
						</label>
						<label class="gender-tile" id="tile-female">
							<span class="gender-icon" style="display: inline-flex; align-items: center; justify-content: center;">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="9" r="5"></circle>
									<line x1="12" y1="14" x2="12" y2="21"></line>
									<line x1="9" y1="18" x2="15" y2="18"></line>
								</svg>
							</span>
							<span class="gender-label">Female</span>
							<input type="radio" name="gender" value="female" />
						</label>
						<label class="gender-tile" id="tile-other">
							<span class="gender-icon" style="display: inline-flex; align-items: center; justify-content: center;">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="4"></circle>
									<line x1="12" y1="16" x2="12" y2="22"></line>
									<line x1="9" y1="19" x2="15" y2="19"></line>
									<polyline points="16 4 20 4 20 8"></polyline>
									<line x1="20" y1="4" x2="15" y2="9"></line>
								</svg>
							</span>
							<span class="gender-label">Other</span>
							<input type="radio" name="gender" value="other" />
						</label>
					</div>
				</div>
			</div>
			<div class="form-row" style="margin-top: 1rem;">
				<div class="field" style="grid-column: span 2;">
					<label for="location">Birth Location (City, Country)</label>
					<input type="text" id="location" name="location" required placeholder="e.g. New Delhi, India" autocomplete="off" />
					<div id="suggestions"></div>
					<input type="hidden" id="lat" name="lat" />
					<input type="hidden" id="lon" name="lon" />
				</div>
			</div>

			<p style="font-size: var(--font-xs); color: var(--bumble-text-light); text-align: center; margin-top: 2rem; margin-bottom: 0.5rem; font-weight: 500;">By submitting your details, you agree to our <a href="/terms" style="color: var(--bumble-text); text-decoration: underline; font-weight: 700;">Terms of Service</a>.</p>

			<div class="form-actions">
				<button type="button" class="btn btn-reset" id="prev1Btn">Previous</button>
				<button type="submit" class="btn btn-submit" id="submitBtn">Submit Details</button>
			</div>
		</div>
	</form>
)}

{/* Custom Mobile Verification Overlay Modal */}
{!isEdit && (
<div id="mobile-verify-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(143,118,99,0.3); z-index: 10000; align-items: center; justify-content: center; padding: 1rem; backdrop-filter: blur(4px);">
  <div style="background: white; border: 2.5px solid var(--bumble-yellow); border-radius: 24px; padding: 2rem; max-width: 420px; width: 100%; box-shadow: 0 12px 36px rgba(143,118,99,0.12); text-align: center;">
    <h3 style="margin-top: 0; font-family: var(--font-secondary); color: var(--bumble-text); border-bottom: none; font-size: var(--font-base); text-align: center; font-weight: 800;">Verify Your Mobile Number</h3>
    <p style="font-size: var(--font-sm); color: var(--bumble-text); margin-bottom: 2rem; line-height: 1.6; text-align: center; font-weight: 500;">
      Please confirm that your mobile number is correct:<br/>
      <strong id="modal-phone-display" style="font-size: var(--font-xl); color: var(--bumble-text); display: block; margin: 1rem 0; letter-spacing: 1.5px; background-color: var(--bumble-yellow); padding: 0.5rem; border-radius: 12px; border: 1.5px solid var(--bumble-yellow);"></strong>
      We do not allow changing your mobile number once your account is created.
    </p>
    <div style="display: flex; gap: 0.75rem; justify-content: center;">
      <button type="button" id="modal-cancel-btn" class="btn btn-reset" style="padding: 0.6rem; border-radius: 12px; margin: 0;">Edit Number</button>
      <button type="button" id="modal-confirm-btn" class="btn btn-submit" style="padding: 0.6rem; border-radius: 12px; margin: 0; flex: 1.5;">Confirm</button>
    </div>
  </div>
</div>
)}

<script>
		import { getOrSetUserId, getCookie, setCookie, clearUserData } from '../lib/user';
		import { fetchUsers, invalidateUsersCache, saveUserProfile } from '../lib/api';

		const form = document.getElementById('detailsForm') as HTMLFormElement;
		const isEditMode = form?.getAttribute('data-is-edit') === 'true';

		const pageTitle = document.getElementById('page-title') as HTMLHeadingElement;
		const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
		const nameInput = document.getElementById('name') as HTMLInputElement;
		const emailInput = document.getElementById('email') as HTMLInputElement;
		const dobInput = document.getElementById('dob') as HTMLInputElement;
		const tobInput = document.getElementById('tob') as HTMLInputElement;
		const cancelBtns = document.querySelectorAll('.cancelBtn');
		const locationInput = document.getElementById('location') as HTMLInputElement;
		const suggestionsContainer = document.getElementById('suggestions') as HTMLDivElement;
		const latInput = document.getElementById('lat') as HTMLInputElement;
		const lonInput = document.getElementById('lon') as HTMLInputElement;
		const currentLocationInput = document.getElementById('currentLocation') as HTMLInputElement;
		const currentSuggestionsContainer = document.getElementById('currentSuggestions') as HTMLDivElement;
		const currentLatInput = document.getElementById('currentLat') as HTMLInputElement;
		const currentLonInput = document.getElementById('currentLon') as HTMLInputElement;
		const phoneInput = document.getElementById('phone') as HTMLInputElement;
		const pinInput = document.getElementById('pin') as HTMLInputElement;

		// Modal Elements for Signup
		const verifyModal = document.getElementById('mobile-verify-modal') as HTMLDivElement;
		const modalPhoneDisplay = document.getElementById('modal-phone-display') as HTMLElement;
		const modalCancelBtn = document.getElementById('modal-cancel-btn') as HTMLButtonElement;
		const modalConfirmBtn = document.getElementById('modal-confirm-btn') as HTMLButtonElement;

		// Generate or retrieve the standard User ID
		const uid = getOrSetUserId();

		// Gender tiles custom script handlers to set native selected styling
		const genderRadioInputs = document.querySelectorAll('input[name="gender"]') as NodeListOf<HTMLInputElement>;

		function updateGenderTileStyles() {
			genderRadioInputs.forEach(input => {
				const parent = input.parentElement;
				if (parent) {
					if (input.checked) {
						parent.classList.add('selected');
					} else {
						parent.classList.remove('selected');
					}
				}
			});
		}

		// Listen to change events on the radio buttons themselves.
		// This handles both mouse clicks (which natively toggle the radio) and keyboard navigation.
		genderRadioInputs.forEach(input => {
			input.addEventListener('change', updateGenderTileStyles);
		});

		genderRadioInputs.forEach(input => {
			input.addEventListener('change', updateGenderTileStyles);
		});

		// Pre-fill form from cookies in Edit mode
		function preFillForm() {
			const stored = getCookie('user_details');
			if (stored) {
				try {
					const details = JSON.parse(stored);
					const fields = [
						'name', 'email', 'phone', 'pin', 'dob', 'tob', 'location', 'lat', 'lon',
						'currentLocation', 'currentLat', 'currentLon', 'height',
						'education', 'occupation', 'income', 'religion', 'bio'
					];
					fields.forEach(field => {
						const element = document.getElementById(field) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
						if (element && details[field] !== undefined) {
							element.value = details[field];
						}
					});

					if (details.tob && tobInput) {
						tobInput.value = details.tob;
					}

					// Set gender radio checking and trigger layout updates
					if (details.gender) {
						genderRadioInputs.forEach(radio => {
							if (radio.value === details.gender.toLowerCase()) {
								radio.checked = true;
							}
						});
						updateGenderTileStyles();
					}
				} catch (e) {
					console.error('Error parsing user_details cookie:', e);
				}
			}
		}

		// Run prefill unconditionally if data exists
		preFillForm();

		// Auto-detect current location via IP if blank and in edit mode
		async function autoDetectLocation() {
			if (isEditMode && currentLocationInput && !currentLocationInput.value) {
				const SESSION_CACHE_KEY = 'auto_detected_location';
				const cached = sessionStorage.getItem(SESSION_CACHE_KEY);
				if (cached) {
					try {
						const data = JSON.parse(cached);
						currentLocationInput.value = data.location;
						currentLatInput.value = data.lat;
						currentLonInput.value = data.lon;
						return;
					} catch (e) {
						sessionStorage.removeItem(SESSION_CACHE_KEY);
					}
				}

				try {
					const response = await fetch('https://ipapi.co/json/');
					if (response.ok) {
						const data = await response.json();
						if (data && data.city && data.country_name) {
							const locationStr = `${data.city}, ${data.country_name}`;
							currentLocationInput.value = locationStr;
							currentLatInput.value = data.latitude;
							currentLonInput.value = data.longitude;

							sessionStorage.setItem(SESSION_CACHE_KEY, JSON.stringify({
								location: locationStr,
								lat: data.latitude,
								lon: data.longitude
							}));
						}
					}
				} catch (e) {
					console.error('Failed to auto-detect location via IP:', e);
				}
			}
		}
		autoDetectLocation();

		cancelBtns.forEach(btn => btn.addEventListener('click', () => {
			window.location.href = '/dashboard';
		}));

		// Location Autocomplete Setup Function
		const autocompleteCache = new Map<string, any[]>();
		function setupAutocomplete(inputEl: HTMLInputElement, suggestionsEl: HTMLDivElement, latEl: HTMLInputElement, lonEl: HTMLInputElement) {
			if (!inputEl) return;
			let timeout: ReturnType<typeof setTimeout>;
			inputEl.addEventListener('input', () => {
				clearTimeout(timeout);
				const query = inputEl.value.trim().toLowerCase();
				if (query.length < 3) {
					suggestionsEl.style.display = 'none';
					return;
				}

				if (autocompleteCache.has(query)) {
					renderSuggestions(autocompleteCache.get(query)!);
					return;
				}

				timeout = setTimeout(async () => {
					try {
						suggestionsEl.innerHTML = '<div class="suggestion-item" style="color: var(--bumble-text-light);">Searching locations...</div>';
						suggestionsEl.style.display = 'block';

						const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=5`);

						if (!response.ok) throw new Error('Network response was not ok');

						const data = await response.json();
						autocompleteCache.set(query, data);
						renderSuggestions(data);
					} catch (error) {
						console.error('Error fetching locations:', error);
						suggestionsEl.innerHTML = '<div class="suggestion-item" style="color: #ff4444;">Error connecting to location service. Please type manually or try again.</div>';
						suggestionsEl.style.display = 'block';
					}
				}, 300);
			});

			function renderSuggestions(data: any[]) {
				suggestionsEl.innerHTML = '';
				if (data.length > 0) {
					data.forEach((item: any) => {
						const div = document.createElement('div');
						div.className = 'suggestion-item';
						div.textContent = item.display_name;
						div.addEventListener('click', () => {
							inputEl.value = item.display_name;
							latEl.value = item.lat;
							lonEl.value = item.lon;
							suggestionsEl.style.display = 'none';
						});
						suggestionsEl.appendChild(div);
					});
					suggestionsEl.style.display = 'block';
				} else {
					suggestionsEl.innerHTML = '<div class="suggestion-item" style="color: #ff4444;">No locations found. Try a different city.</div>';
					suggestionsEl.style.display = 'block';
				}
			}

			document.addEventListener('click', (e) => {
				if (e.target !== inputEl) {
					suggestionsEl.style.display = 'none';
				}
			});
		}

		setupAutocomplete(locationInput, suggestionsContainer, latInput, lonInput);
		setupAutocomplete(currentLocationInput, currentSuggestionsContainer, currentLatInput, currentLonInput);

		const errorMsgEl = document.getElementById('form-error-message') as HTMLDivElement;

		const showError = (msg: string, focusEl?: HTMLElement) => {
			if (errorMsgEl) {
				errorMsgEl.textContent = msg;
				errorMsgEl.style.display = 'block';
				window.scrollTo({ top: 0, behavior: 'smooth' });
			} else {
				alert(msg);
			}
			if (focusEl) focusEl.focus();
		};

		const step1 = document.getElementById('step1') as HTMLDivElement;
		const step2 = document.getElementById('step2') as HTMLDivElement;

		const next1Btn = document.getElementById('next1Btn') as HTMLButtonElement;
		const prev1Btn = document.getElementById('prev1Btn') as HTMLButtonElement;

		// Validation logic based on form type (Signup vs Edit)
		const validateStage1 = async (): Promise<boolean> => {
			if (errorMsgEl) errorMsgEl.style.display = 'none';

			if (!isEditMode) {
				// SIGNUP: Validate phone and pin
				const phoneRegex = /^[0-9]{10}$/;
				if (!phoneInput.value || !phoneRegex.test(phoneInput.value)) {
					showError('Please enter a valid 10-digit mobile number.', phoneInput);
					return false;
				}

				const pinRegex = /^[0-9]{4}$/;
				if (!pinInput.value || !pinRegex.test(pinInput.value)) {
					showError('Please enter a valid 4-digit numeric PIN.', pinInput);
					return false;
				}

				// Check if the mobile number is already registered in the system
				next1Btn.disabled = true;
				const originalText = next1Btn.textContent;
				next1Btn.textContent = 'Verifying...';

				try {
					invalidateUsersCache();
					const users = await fetchUsers();
					const phoneExists = users.some(u => u.phone === phoneInput.value);
					if (phoneExists) {
						showError('This mobile number is already registered. Please log in.', phoneInput);
						next1Btn.disabled = false;
						next1Btn.textContent = originalText;
						return false;
					}
				} catch (err) {
					console.error('Failed to verify phone uniqueness:', err);
				}

				next1Btn.disabled = false;
				next1Btn.textContent = originalText;

				// Show Custom Mobile Verification Modal
				if (verifyModal && modalPhoneDisplay) {
					modalPhoneDisplay.textContent = phoneInput.value;
					verifyModal.style.display = 'flex';
					return false; // Don't proceed to Stage 2 yet; wait for modal confirmation
				}

				return true;
			} else {
				// EDIT MODE: Validate Basic Details
				if (!nameInput.value || nameInput.value.length < 2) {
					showError('Please enter your full name (at least 2 characters).', nameInput);
					return false;
				}

				const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
				if (!emailInput.value || !emailRegex.test(emailInput.value)) {
					showError('Please enter a valid email address.', emailInput);
					return false;
				}

				if (!dobInput.value) {
					showError('Please select your Date of Birth.', dobInput);
					return false;
				}

				if (!tobInput.value) {
					showError('Please select your complete Time of Birth.', tobInput);
					return false;
				}

				let genderVal = '';
				genderRadioInputs.forEach(r => { if (r.checked) genderVal = r.value; });
				if (!genderVal) {
					showError('Please select your Gender.');
					return false;
				}

				if (!locationInput.value) {
					showError('Please enter your birth location.', locationInput);
					return false;
				}

				if (!latInput.value || !lonInput.value) {
					showError('Please select a location from the suggestions list to get accurate coordinates.', locationInput);
					return false;
				}

				const pinRegex = /^[0-9]{4}$/;
				if (!pinInput.value || !pinRegex.test(pinInput.value)) {
					showError('Please enter a valid 4-digit numeric PIN.', pinInput);
					return false;
				}

				return true;
			}
		};

		const validateStage2 = () => {
			if (errorMsgEl) errorMsgEl.style.display = 'none';

			if (!isEditMode) {
				// SIGNUP STAGE 2: Validate Basic Details
				if (!nameInput.value || nameInput.value.length < 2) {
					showError('Please enter your full name (at least 2 characters).', nameInput);
					return false;
				}

				const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
				if (!emailInput.value || !emailRegex.test(emailInput.value)) {
					showError('Please enter a valid email address.', emailInput);
					return false;
				}

				if (!dobInput.value) {
					showError('Please select your Date of Birth.', dobInput);
					return false;
				}

				if (!tobInput.value) {
					showError('Please select your complete Time of Birth.', dobInput);
					return false;
				}

				let genderVal = '';
				genderRadioInputs.forEach(r => { if (r.checked) genderVal = r.value; });
				if (!genderVal) {
					showError('Please select your Gender.');
					return false;
				}

				if (!locationInput.value) {
					showError('Please enter your birth location.', locationInput);
					return false;
				}

				if (!latInput.value || !lonInput.value) {
					showError('Please select a location from the suggestions list to get accurate coordinates.', locationInput);
					return false;
				}

				return true;
			} else {
				// EDIT STAGE 2: Validate Optional Details
				if (currentLocationInput.value && (!currentLatInput.value || !currentLonInput.value)) {
					showError('Please select your current location from the suggestions list to get accurate coordinates.', currentLocationInput);
					return false;
				}
				return true;
			}
		};

		form?.addEventListener('keydown', function(event) {
			if (event.key === 'Enter') {
				const target = event.target as HTMLElement;
				if (target && target.tagName.toLowerCase() !== 'textarea' && target.tagName.toLowerCase() !== 'button') {
					event.preventDefault();
				}
			}
		});

		// Modal button listeners (Signup only)
		modalCancelBtn?.addEventListener('click', () => {
			if (verifyModal) verifyModal.style.display = 'none';
		});

		modalConfirmBtn?.addEventListener('click', () => {
			if (verifyModal) verifyModal.style.display = 'none';
			// Proceed to Stage 2
			step1.style.display = 'none';
			step2.style.display = 'block';
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});

		next1Btn?.addEventListener('click', async () => {
			const success = await validateStage1();
			if (success) {
				step1.style.display = 'none';
				step2.style.display = 'block';
				window.scrollTo({ top: 0, behavior: 'smooth' });
			}
		});

		prev1Btn?.addEventListener('click', () => {
			step2.style.display = 'none';
			step1.style.display = 'block';
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});

		form?.addEventListener('submit', async (e) => {
			e.preventDefault();

			if (!validateStage2()) {
				return;
			}

			const formData = new FormData(form);
			const data = Object.fromEntries(formData.entries());

			// Construct the profile payload
			const payload: any = {
				...data,
				uid: uid,
				maritalStatus: isEditMode ? (data.maritalStatus || 'available') : 'available'
			};

			// Save to local cookie immediately for dashboard use
			setCookie('user_details', JSON.stringify(payload), 365);

			// Show loading state on submit button
			submitBtn.disabled = true;
			const originalBtnText = submitBtn.textContent;
			submitBtn.textContent = 'Saving...';

			try {
				const { saveUserProfile } = await import('../lib/api');
				const { calculateAstrology } = await import('../lib/astrology');

				// Calculate basic astrology for the user to store it
				const lat = payload.lat ? parseFloat(payload.lat as string) : 28.6139;
				const lon = payload.lon ? parseFloat(payload.lon as string) : 77.2090;
				const astroData = calculateAstrology(payload.dob as string, payload.tob as string, lat, lon);

				const profileToSave = {
					...payload,
					nakshatraIdx: astroData.panchang.nakshatraIdx,
					moonSignIdx: astroData.panchang.moonSignIdx,
					isMoonManglik: astroData.panchang.isMoonManglik,
					isLaganManglik: astroData.panchang.isLaganManglik,
					matches: [] // populated by dashboard
				};

				await saveUserProfile(profileToSave);
				window.location.href = '/dashboard';
			} catch (error) {
				console.error('Error saving profile:', error);
				// Even if save fails, redirect because we have local cookies set
				window.location.href = '/dashboard';
			}
		});
</script>
