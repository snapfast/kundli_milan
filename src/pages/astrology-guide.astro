---
import Layout from '../layouts/Layout.astro';
---

<Layout title="User Manual - Understanding moonine & Guna Milan" description="Deep dive into Vedic Astrology matchmaking. Learn about the 8 Kootas, Ashta Koota matching, Manglik Dosha, and how moonine calculates compatibility.">
    <style>
        .guide-section {
            margin-bottom: 2rem;
        }
        .guide-section h1 {
            text-align: center;
            border-bottom: none;
            margin-bottom: 0.25rem;
            font-family: var(--font-secondary);
            font-size: var(--font-3xl);
        }
        .guide-section h2 {
            text-align: center;
            border-bottom: none;
            margin-top: 1.5rem;
            color: #6366f1;
        }
        .visual-table {
            width: 100%;
            border-collapse: collapse;
            font-size: var(--font-sm);
            margin: 1rem 0;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            overflow: hidden;
        }
        .visual-table th, .visual-table td {
            padding: 0.6rem 0.75rem;
            text-align: left;
            border-bottom: 1px solid #f1f5f9;
        }
        .visual-table th {
            background-color: #f8fafc;
            color: #475569;
            font-weight: 700;
            text-transform: uppercase;
            font-size: var(--font-xs);
        }
        .score-badge {
            background: #e0e7ff;
            color: #4338ca;
            padding: 0.1rem 0.4rem;
            border-radius: 4px;
            font-weight: 700;
            font-size: var(--font-xs);
        }
        .dosha-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }
        .dosha-card {
            background: #fff;
            background-image: var(--floral-bg);
            background-size: 300px 300px;
            border: 1px solid #e2e8f0;
            padding: 0.75rem;
            border-radius: 6px;
        }
        .dosha-title {
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 0.25rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .dosha-desc {
            font-size: var(--font-sm);
            color: #475569;
            line-height: 1.4;
        }
    </style>

    <section class="guide-section">
        <h1>User Manual</h1>
        <p style="text-align: center; font-style: italic; color: #64748b; margin-bottom: 2rem;">Ancient Vedic Wisdom meets Modern Matchmaking</p>
    </section>

    <section class="guide-section">
        <h2 style="font-family: var(--font-secondary); font-size: var(--font-2xl);">Ashta Koota (36 Points)</h2>
        <div style="overflow-x: auto;">
            <table class="visual-table">
                <thead>
                    <tr>
                        <th>Koota</th>
                        <th>Compatibility Aspect</th>
                        <th>Max Score</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Varna</strong></td>
                        <td>Work style and ego matching.</td>
                        <td><span class="score-badge">1 Point</span></td>
                    </tr>
                    <tr>
                        <td><strong>Vashya</strong></td>
                        <td>Mutual attraction and how you balance each other's power.</td>
                        <td><span class="score-badge">2 Points</span></td>
                    </tr>
                    <tr>
                        <td><strong>Tara</strong></td>
                        <td>General well-being and health of the couple.</td>
                        <td><span class="score-badge">3 Points</span></td>
                    </tr>
                    <tr>
                        <td><strong>Yoni</strong></td>
                        <td>Natural physical chemistry and biological bonding.</td>
                        <td><span class="score-badge">4 Points</span></td>
                    </tr>
                    <tr>
                        <td><strong>Maitri</strong></td>
                        <td>Friendship, shared values, and mutual respect.</td>
                        <td><span class="score-badge">5 Points</span></td>
                    </tr>
                    <tr>
                        <td><strong>Gana</strong></td>
                        <td>Personality type and general outlook on life.</td>
                        <td><span class="score-badge">6 Points</span></td>
                    </tr>
                    <tr>
                        <td><strong>Bhakoot</strong></td>
                        <td>Deep emotional harmony and long-term prosperity.</td>
                        <td><span class="score-badge">7 Points</span></td>
                    </tr>
                    <tr>
                        <td><strong>Nadi</strong></td>
                        <td>Vital energy compatibility and health of future generations.</td>
                        <td><span class="score-badge">8 Points</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="guide-section">
        <h2 style="font-family: var(--font-secondary); font-size: var(--font-2xl);">Major Relationship Challenges (Doshas)</h2>
        <div class="dosha-grid">
            <div class="dosha-card">
                <div class="dosha-title">🔥 Manglik Dosha</div>
                <div class="dosha-desc">Represents an intense, fiery energy that can lead to frequent arguments, dominance issues, or a general lack of peace in the household if not understood.</div>
            </div>
            <div class="dosha-card">
                <div class="dosha-title">🌑 Bhakoot Dosha</div>
                <div class="dosha-desc">Indicates a mismatch in emotional waves and prosperity. It can manifest as feelings of emotional isolation, financial instability, or a struggle to grow together.</div>
            </div>
            <div class="dosha-card">
                <div class="dosha-title">🧬 Nadi Dosha</div>
                <div class="dosha-desc">Refers to a core energetic mismatch. Couples might face chronic health issues, low physical energy, or difficulties in starting a family.</div>
            </div>
            <div class="dosha-card">
                <div class="dosha-title">👹 Gana Dosha</div>
                <div class="dosha-desc">A fundamental clash in temperament. For example, one person may be very peace-loving while the other is highly assertive, leading to a constant struggle to find common ground.</div>
            </div>
        </div>
    </section>

    <section class="guide-section" style="background: #f8fafc; padding: 1rem; border-radius: 6px; margin-top: 2rem;">
        <h2 style="font-family: var(--font-secondary); font-size: var(--font-2xl); margin-top: 0;">Match Classifications</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 1rem;">
            <div style="text-align: center;">
                <div style="font-size: var(--font-lg);">💎</div>
                <div style="font-weight: 700; font-size: var(--font-sm);">Excellent</div>
                <div style="font-size: var(--font-xs); color: #64748b;">> 28 Points</div>
            </div>
            <div style="text-align: center;">
                <div style="font-size: var(--font-lg);">✨</div>
                <div style="font-weight: 700; font-size: var(--font-sm);">Very Good</div>
                <div style="font-size: var(--font-xs); color: #64748b;">21 - 28 Points</div>
            </div>
            <div style="text-align: center;">
                <div style="font-size: var(--font-lg);">🤝</div>
                <div style="font-weight: 700; font-size: var(--font-sm);">Good</div>
                <div style="font-size: var(--font-xs); color: #64748b;">18 - 20 Points</div>
            </div>
            <div style="text-align: center;">
                <div style="font-size: var(--font-lg);">⚠️</div>
                <div style="font-weight: 700; font-size: var(--font-sm);">Not Good</div>
                <div style="font-size: var(--font-xs); color: #64748b;">12 - 17 Points</div>
            </div>
            <div style="text-align: center;">
                <div style="font-size: var(--font-lg);">🛑</div>
                <div style="font-weight: 700; font-size: var(--font-sm);">Bad</div>
                <div style="font-size: var(--font-xs); color: #64748b;">0 - 11 Points</div>
            </div>
        </div>
        <p style="font-size: var(--font-xs); color: #64748b; text-align: center; margin-top: 1rem; font-style: italic;">
            Note: Special cosmic alignments like "Destined Union" or "Intellectual Harmony" may provide additional context to these primary classifications.
        </p>
    </section>

    <div style="text-align: center; margin-top: 3rem;">
        <div class="logo" style="font-size: 6rem; margin-bottom: 0;">moonine</div>
    </div>

    <div style="text-align: center; margin: 3rem 0;">
        <a href="/" class="btn">Start Your Cosmic Matchmaking</a>
    </div>

</Layout>
