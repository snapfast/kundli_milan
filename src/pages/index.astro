---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Milan Moon - Astrology Matchmaker">
	<style>
		#suggestions {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: white;
			border: 1px solid #ccc;
			border-top: none;
			z-index: 1000;
			max-height: 200px;
			overflow-y: auto;
			display: none;
			border-radius: 0 0 4px 4px;
			box-shadow: 0 4px 6px rgba(0,0,0,0.1);
		}
		.suggestion-item {
			padding: 0.75rem;
			cursor: pointer;
			border-bottom: 1px solid #eee;
		}
		.suggestion-item:last-child {
			border-bottom: none;
		}
		footer {
			margin-top: 2rem;
			font-size: 0.75rem;
			color: #6c757d;
			text-align: center;
		}
		.form-actions {
			display: flex;
			gap: 0.75rem;
			margin-top: 0.5rem;
		}
		.btn-submit {
			flex: 2;
		}
		.btn-reset {
			flex: 1;
		}
	</style>

	<h1>Submit Your Details</h1>
		<div id="redirecting" style="display: none; text-align: center; padding: 2rem;">
			Redirecting to your dashboard...
		</div>

		<form id="detailsForm">
			<div class="form-row">
				<div class="field">
					<label for="name">Full Name</label>
					<input type="text" id="name" name="name" required minlength="2" maxlength="50" placeholder="Enter your full name" />
				</div>
				<div class="field">
					<label for="email">Email Address</label>
					<input type="email" id="email" name="email" required placeholder="your.email@example.com" />
				</div>
			</div>
			<div class="form-row">
				<div class="field">
					<label for="dob">Date of Birth</label>
					<input type="date" id="dob" name="dob" required max={new Date().toISOString().split('T')[0]} />
				</div>
				<div class="field">
					<label for="tob">Time of Birth</label>
					<input type="time" id="tob" name="tob" required />
				</div>
			</div>
			<div class="form-row">
				<div class="field">
					<label for="gender">Gender</label>
					<select id="gender" name="gender" required>
						<option value="">Select Gender</option>
						<option value="male">Male</option>
						<option value="female">Female</option>
						<option value="other">Other</option>
					</select>
				</div>
				<div class="field">
					<label for="location">Location (City, Country)</label>
					<input type="text" id="location" name="location" required placeholder="e.g. New Delhi, India" autocomplete="off" />
					<div id="suggestions"></div>
					<input type="hidden" id="lat" name="lat" />
					<input type="hidden" id="lon" name="lon" />
				</div>
			</div>
			<div class="form-actions">
				<button type="submit" class="btn-submit">Submit Details</button>
				<button type="button" id="resetBtn" class="btn-reset btn-danger">Reset</button>
			</div>
		</form>

	<section class="seo-content" style="margin-top: 4rem; border-top: 1px solid #eee; padding-top: 2rem;">
		<h2>What is Milan Moon Vedic Astrology Matchmaking?</h2>
		<p>
			Milan Moon is a specialized platform designed to bring the ancient wisdom of Vedic Astrology (Jyotish) into the modern era. Our primary focus is <strong>Kundli Milan</strong>, the traditional practice of matching horoscopes to ensure a harmonious and prosperous partnership.
		</p>

		<h3>The Power of Guna Milan</h3>
		<p>
			At the heart of our matchmaking engine is the <strong>Ashta Koota</strong> system, often referred to as <strong>Guna Milan</strong>. This system evaluates compatibility based on eight different aspects (Kootas) of the partners' lives, derived from their Nakshatras (Birth Stars) and Rasis (Moon Signs).
		</p>

		<p>The eight Kootas include:</p>
		<ul>
			<li><strong>Varna:</strong> Spiritual compatibility and ego.</li>
			<li><strong>Vashya:</strong> Mutual attraction and dominance.</li>
			<li><strong>Tara:</strong> Health and longevity.</li>
			<li><strong>Yoni:</strong> Sexual compatibility and nature.</li>
			<li><strong>Maitri:</strong> Psychological compatibility and friendship.</li>
			<li><strong>Gana:</strong> Temperament and character.</li>
			<li><strong>Bhakoot:</strong> Family and financial prosperity.</li>
			<li><strong>Nadi:</strong> Progeny and genetic compatibility.</li>
		</ul>

		<h3>Why Choose Milan Moon?</h3>
		<p>
			Unlike generic dating apps, Milan Moon provides deep insights into the cosmic forces that influence relationships. Whether you're looking for a "Soul Connection" or "Destined Union," our algorithm calculates your unique compatibility score out of 36 points, helping you make informed decisions about your future.
		</p>

		<h3>Understanding Manglik Dosha</h3>
		<p>
			We also factor in <strong>Manglik Dosha</strong> (Kuja Dosha), a significant consideration in Vedic Astrology. Our system identifies Manglik status for both partners and applies traditional cancellation rules to provide a balanced and accurate compatibility report.
		</p>

		<p style="text-align: center; margin-top: 2rem;">
			<a href="/astrology-guide" class="btn">Read Our Full Astrology Guide</a>
		</p>
	</section>

	<footer>
		&copy; {new Date().getFullYear()} Milan Moon.
		Location data &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a> contributors.
	</footer>

	<script>
			import { getOrSetUserId, getCookie, setCookie, clearUserData } from '../lib/user';
			import { fetchUsers, resetUserProfile } from '../lib/api';

			// Immediate redirection if user details already exist
			const urlParams = new URLSearchParams(window.location.search);
			const isEditMode = urlParams.get('edit') === 'true';
			const storedDetails = getCookie('user_details');

			if (storedDetails && !isEditMode) {
				window.location.href = '/dashboard';
			}

			const form = document.getElementById('detailsForm') as HTMLFormElement;
			const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement;
			const locationInput = document.getElementById('location') as HTMLInputElement;
			const suggestionsContainer = document.getElementById('suggestions') as HTMLDivElement;
			const latInput = document.getElementById('lat') as HTMLInputElement;
			const lonInput = document.getElementById('lon') as HTMLInputElement;
			const redirectingDiv = document.getElementById('redirecting') as HTMLDivElement;

			// Ensure user ID is set on load
			const uid = getOrSetUserId();

			// Pre-fill form from cookies
			function preFillForm() {
				const stored = getCookie('user_details');
				if (stored) {
					try {
						const details = JSON.parse(stored);
						const fields = ['name', 'email', 'dob', 'tob', 'gender', 'location', 'lat', 'lon'];
						fields.forEach(field => {
							const element = document.getElementById(field) as HTMLInputElement | HTMLSelectElement;
							if (element && details[field]) {
								element.value = details[field];
							}
						});
					} catch (e) {
						console.error('Error parsing user_details cookie:', e);
					}
				}
			}
			preFillForm();

			// Auto-save logic
			function autoSave() {
				const formData = new FormData(form);
				const data = Object.fromEntries(formData.entries());
				const payload = {
					...data,
					uid: getOrSetUserId()
				};
				setCookie('user_details', JSON.stringify(payload), 365);
			}

			form.addEventListener('input', autoSave);
			form.addEventListener('change', autoSave);

			// Check if user already exists and redirect to dashboard if so
			async function checkExistingUser() {
				const users = await fetchUsers();
				const existingUser = users.find(u => u.uid === uid);
				if (existingUser && existingUser.name) { // Ensure they actually have a profile
					form.style.display = 'none';
					redirectingDiv.style.display = 'block';

					// Hide the dashboard link since we are redirecting anyway
					const dashboardLink = document.getElementById('dashboardLink');
					if (dashboardLink) {
						dashboardLink.style.display = 'none';
					}

					window.location.href = '/dashboard';
				}
			}
			checkExistingUser();

			resetBtn?.addEventListener('click', async () => {
				if (confirm('Are you sure you want to reset your profile? This will delete all your local and saved data.')) {
					const uid = getOrSetUserId();
					if (uid) await resetUserProfile(uid);
					clearUserData();
					window.location.reload();
				}
			});

			// Location Autocomplete
			let timeout: ReturnType<typeof setTimeout>;
			locationInput?.addEventListener('input', () => {
				clearTimeout(timeout);
				const query = locationInput.value;
				if (query.length < 3) {
					suggestionsContainer.style.display = 'none';
					return;
				}

				timeout = setTimeout(async () => {
					try {
						suggestionsContainer.innerHTML = '<div class="suggestion-item" style="color: #666;">Searching locations...</div>';
						suggestionsContainer.style.display = 'block';

						const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=5`);

						if (!response.ok) throw new Error('Network response was not ok');

						const data = await response.json();

						suggestionsContainer.innerHTML = '';
						if (data.length > 0) {
							data.forEach((item: any) => {
								const div = document.createElement('div');
								div.className = 'suggestion-item';
								div.textContent = item.display_name;
								div.addEventListener('click', () => {
									locationInput.value = item.display_name;
									latInput.value = item.lat;
									lonInput.value = item.lon;
									suggestionsContainer.style.display = 'none';
									autoSave(); // Ensure lat/lon are saved
								});
								suggestionsContainer.appendChild(div);
							});
							suggestionsContainer.style.display = 'block';
						} else {
							suggestionsContainer.innerHTML = '<div class="suggestion-item" style="color: #dc3545;">No locations found. Try a different city.</div>';
							suggestionsContainer.style.display = 'block';
						}
					} catch (error) {
						console.error('Error fetching locations:', error);
						suggestionsContainer.innerHTML = '<div class="suggestion-item" style="color: #dc3545;">Error connecting to location service. Please type manually or try again.</div>';
						suggestionsContainer.style.display = 'block';
					}
				}, 300);
			});

			document.addEventListener('click', (e) => {
				if (e.target !== locationInput) {
					suggestionsContainer.style.display = 'none';
				}
			});

			form?.addEventListener('submit', async (e) => {
				e.preventDefault();

				const formData = new FormData(form);
				const data = Object.fromEntries(formData.entries());
				const uid = getOrSetUserId();

				const payload = {
					...data,
					uid: uid
				};

				// Save to cookie immediately for dashboard use
				setCookie('user_details', JSON.stringify(payload), 365);

				// Show loading state on button
				const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
				const originalText = submitBtn.textContent;
				submitBtn.disabled = true;
				submitBtn.textContent = 'Saving...';

				try {
					// We import saveUserProfile here or at the top
					const { saveUserProfile } = await import('../lib/api');
					const { calculateAstrology } = await import('../lib/astrology');

					// Calculate basic astrology for the user to store it
					const lat = payload.lat ? parseFloat(payload.lat as string) : 28.6139;
					const lon = payload.lon ? parseFloat(payload.lon as string) : 77.2090;
					const astroData = calculateAstrology(payload.dob as string, payload.tob as string, lat, lon);

					const profileToSave = {
						...payload,
						nakshatraIdx: astroData.panchang.nakshatraIdx,
						moonSignIdx: astroData.panchang.moonSignIdx,
						isMoonManglik: astroData.panchang.isMoonManglik,
						isLaganManglik: astroData.panchang.isLaganManglik,
						matches: [] // Will be populated by dashboard
					} as any;

					await saveUserProfile(profileToSave);
					window.location.href = '/dashboard';
				} catch (error) {
					console.error('Error saving profile:', error);
					// Even if save fails, we go to dashboard because we have local cookies
					window.location.href = '/dashboard';
				}
			});
	</script>
</Layout>
