---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Your Profile - moonine">
	<style is:global>
		.dashboard-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
			gap: 0.5rem;
			margin-bottom: 1rem;
		}
		.info-card {
			background: #fff;
			background-image: var(--floral-bg);
			background-size: 300px 300px;
			border: 1px solid #e2e8f0;
			padding: 0.4rem 0.6rem;
			border-radius: 4px;
		}
		.info-item {
			display: flex;
			flex-direction: column;
		}
		.info-label {
			font-weight: 700;
			color: #1d4046;
			font-size: var(--font-xs);
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}
		.info-value {
			font-size: var(--font-sm);
			color: #1d4046;
			font-weight: 500;
			word-break: normal;
			overflow-wrap: break-word;
			line-height: 1.1;
		}
		.section-title {
			font-size: var(--font-base);
			margin: 0.75rem 0 0.5rem 0;
			border-bottom: 1px solid #f1f5f9;
			padding-bottom: 0.15rem;
			font-weight: 700;
			color: #1d4046;
		}
		.compact-table {
			width: 100%;
			border-collapse: collapse;
			font-size: var(--font-xs);
			background: #fff;
			border-radius: 4px;
			overflow: hidden;
			border: 1px solid #e2e8f0;
		}
		.compact-table th, .compact-table td {
			padding: 0.25rem 0.4rem;
			text-align: left;
			border-bottom: 1px solid #f1f5f9;
		}
		.compact-table th {
			background-color: #f8fafc;
			color: #1d4046;
			font-weight: 700;
		}
		.loading-container {
			text-align: center;
			padding: 4rem 2rem;
		}
		.loader {
			border: 4px solid #f3f3f3;
			border-top: 4px solid #6c5ce7;
			border-radius: 50%;
			width: 40px;
			height: 40px;
			animation: spin 2s linear infinite;
			margin: 0 auto 1rem;
		}
		@keyframes spin {
			0% { transform: rotate(0deg); }
			100% { transform: rotate(360deg); }
		}
		.no-data {
			text-align: center;
			padding: 3rem;
			color: #1d4046;
		}
		.btn-group {
			margin: 2rem 0;
			display: flex;
			gap: 1rem;
			flex-wrap: wrap;
		}
		.btn-sm {
			padding: 0.5rem 1rem;
			font-size: var(--font-sm);
		}
	</style>

	<h1 style="font-family: var(--font-secondary); font-size: var(--font-3xl); border-bottom: none; text-align: center;">Your Profile</h1>

	<div id="loading" class="loading-container">
		<div class="loader"></div>
		<p>Loading your profile details...</p>
	</div>

	<div id="profile-content" style="display: none;">
		<div class="section-title">Profile & Panchang</div>
		<div class="dashboard-grid" id="profile-panchang">
			<!-- Injected here -->
		</div>

		<div id="bio-section" style="display: none; margin-bottom: 1.5rem;">
			<div class="section-title">About Me</div>
			<div class="info-card">
				<p id="bio-content" style="margin: 0; font-size: var(--font-sm); white-space: pre-wrap; color: #1d4046; line-height: 1.4;"></p>
			</div>
		</div>

		<div class="section-title">Planetary Positions</div>
		<div style="overflow-x: auto; margin-bottom: 2rem;">
			<table class="compact-table" id="planets-table">
				<thead>
					<tr>
						<th>Planet</th>
						<th>Rasi</th>
						<th>Degree</th>
						<th>House</th>
					</tr>
				</thead>
				<tbody>
					<!-- Injected here -->
				</tbody>
			</table>
		</div>

		<div class="btn-group">
			<a href="/dashboard" class="btn btn-sm">Back to Dashboard</a>
			<a href="/edit-profile" class="btn btn-sm">Edit My Profile</a>
		</div>
	</div>

	<div id="no-profile" style="display: none;" class="no-data">
		<p>We couldn't find your moonine - A Vedic Matchmaker profile. Please share your birth details to get started!</p>
		<a href="/create-profile" class="btn">Create Profile</a>
	</div>

	<div id="error-state" style="display: none;" class="no-data">
		<p style="color: #ef4444; font-weight: 600;">Error loading profile. Please try refreshing.</p>
		<div class="btn-group" style="justify-content: center;">
			<a href="/" class="btn btn-sm">Back Home</a>
			<button onclick="window.location.reload()" class="btn btn-sm">Retry</button>
		</div>
	</div>

	<script>
		import { getCookie, clearUserData, getOrSetUserId } from '../lib/user';
		import { fetchUsers } from '../lib/api';
		import { calculateAstrology } from '../lib/astrology';

		// Helper for 12h time format
		function formatTime12h(time24: string): string {
			if (!time24) return '';
			const [hourStr, minStr] = time24.split(':');
			const hour = parseInt(hourStr, 10);
			const min = parseInt(minStr, 10);
			const ampm = hour >= 12 ? 'PM' : 'AM';
			const hour12 = hour % 12 || 12;
			return `${hour12}:${minStr.padStart(2, '0')} ${ampm}`;
		}

		document.addEventListener('DOMContentLoaded', async () => {
			const uid = getOrSetUserId();

			let profile: any = null;
			const storedDetails = getCookie('user_details');

			if (storedDetails) {
				try {
					profile = JSON.parse(decodeURIComponent(storedDetails));
				} catch (e) {
					console.error("Error parsing local profile cookie", e);
				}
			}

			if (!profile || !profile.dob || !profile.tob || !profile.lat || !profile.lon) {
				document.getElementById('loading')!.style.display = 'none';
				document.getElementById('no-profile')!.style.display = 'block';
				return;
			}

			try {
				const users = await fetchUsers();

				const userInBackend = users.find(u => u.uid === uid);
				if (userInBackend) {
					profile = { ...profile, ...userInBackend };
				}

				const lat = parseFloat(profile.lat);
				const lon = parseFloat(profile.lon);

				// Calculate missing data
				const astroData = calculateAstrology(profile.dob, profile.tob, lat, lon);

				// Rendering
				document.getElementById('loading')!.style.display = 'none';
				document.getElementById('profile-content')!.style.display = 'block';

				const infoGrid = document.getElementById('profile-panchang')!;
				const items = [
					{ label: 'User ID', value: profile.uid },
					{ label: 'Name', value: profile.name },
					{ label: 'Email', value: profile.email },
					{ label: 'Phone', value: profile.phone },
					{ label: 'Gender', value: profile.gender ? (profile.gender.charAt(0).toUpperCase() + profile.gender.slice(1)) : 'N/A' },
					{ label: 'Marital Status', value: profile.maritalStatus || 'N/A' },
					{ label: 'Born', value: `${profile.dob} ${formatTime12h(profile.tob)}` },
					{ label: 'Birth Location', value: profile.location },
					{ label: 'Current Location', value: profile.currentLocation || 'N/A' },
					{ label: 'Nakshatra', value: astroData.panchang.nakshatra },
					{ label: 'Moon Sign', value: astroData.panchang.moonSign },
					{ label: 'Day (Vara)', value: `${astroData.panchang.vara} (${astroData.panchang.varaLord})` },
					{ label: 'Tithi', value: astroData.panchang.tithi },
					{ label: 'Height', value: profile.height || 'N/A' },
					{ label: 'Religion', value: profile.religion || 'N/A' },
					{ label: 'Education', value: profile.education || 'N/A' },
					{ label: 'Occupation', value: profile.occupation || 'N/A' },
					{ label: 'Income', value: profile.income || 'N/A' },
					{ label: 'Lagan Manglik', value: profile.isLaganManglik ? 'Yes' : 'No' },
					{ label: 'Moon Manglik', value: profile.isMoonManglik ? 'Yes' : 'No' }
				];

				infoGrid.innerHTML = items.map(i => `
					<div class="info-card">
						<div class="info-item">
							<span class="info-label">${i.label}</span>
							<span class="info-value">${i.value}</span>
						</div>
					</div>
				`).join('');

				const bioSection = document.getElementById('bio-section')!;
				const bioContent = document.getElementById('bio-content')!;
				if (profile.bio) {
					bioSection.style.display = 'block';
					bioContent.textContent = profile.bio;
				} else {
					bioSection.style.display = 'none';
				}

				const tbody = document.querySelector('#planets-table tbody')!;
				tbody.innerHTML = ''; // clear before appending
				astroData.planets.forEach(p => {
					const tr = document.createElement('tr');
					tr.innerHTML = `
						<td>${p.name}</td>
						<td>${p.rasi}</td>
						<td>${p.degree}</td>
						<td>${p.house}</td>
					`;
					tbody.appendChild(tr);
				});

			} catch (error) {
				console.error("Profile error:", error);
				document.getElementById('loading')!.style.display = 'none';
				document.getElementById('error-state')!.style.display = 'block';
			}
		});
	</script>
</Layout>
