---
import Layout from '../layouts/Layout.astro';
---

<Layout title="moonine - Dashboard">
	<style is:global>
		.dashboard-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
			gap: 0.5rem;
			margin-bottom: 1rem;
		}
		.info-card {
			background: #fff;
			background-image: var(--floral-bg);
			background-size: 300px 300px;
			border: 1px solid #e2e8f0;
			padding: 0.4rem 0.6rem;
			border-radius: 4px;
		}
		.info-item {
			display: flex;
			flex-direction: column;
		}
		.info-label {
			font-weight: 700;
			color: #64748b;
			font-size: 0.6rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}
		.info-value {
			font-size: 0.8rem;
			color: #0f172a;
			font-weight: 500;
			word-break: normal;
			overflow-wrap: break-word;
			line-height: 1.1;
		}
		.section-title {
			font-size: 1rem;
			margin: 0.75rem 0 0.5rem 0;
			border-bottom: 1px solid #f1f5f9;
			padding-bottom: 0.15rem;
			font-weight: 700;
			color: #334155;
		}
		.compact-table {
			width: 100%;
			border-collapse: collapse;
			font-size: 0.75rem;
			background: #fff;
			border-radius: 4px;
			overflow: hidden;
			border: 1px solid #e2e8f0;
		}
		.compact-table th, .compact-table td {
			padding: 0.25rem 0.4rem;
			text-align: left;
			border-bottom: 1px solid #f1f5f9;
		}
		.compact-table th {
			background-color: #f8fafc;
			color: #475569;
			font-weight: 700;
		}
		.loading-container {
			text-align: center;
			padding: 4rem 2rem;
		}
		.loader {
			border: 4px solid #f3f3f3;
			border-top: 4px solid #6c5ce7;
			border-radius: 50%;
			width: 40px;
			height: 40px;
			animation: spin 2s linear infinite;
			margin: 0 auto 1rem;
		}
		@keyframes spin {
			0% { transform: rotate(0deg); }
			100% { transform: rotate(360deg); }
		}
		.dosha-container {
			margin: 0.5rem 0;
			padding: 0.35rem 0.5rem;
			background: #fef2f2;
			border-left: 2px solid #ef4444;
			border-radius: 3px;
		}
		.dosha-header {
			font-weight: 800;
			color: #991b1b;
			font-size: 0.65rem;
			text-transform: uppercase;
			margin-bottom: 0.2rem;
		}
		.dosha-item {
			margin-bottom: 0.2rem;
		}
		.dosha-item:last-child {
			margin-bottom: 0;
		}
		.dosha-item.cancelled {
			border-left-color: #10b981;
			background: #f0fdf4;
		}
		.dosha-item.cancelled .dosha-name {
			color: #059669;
			text-decoration: line-through;
		}
		.dosha-name {
			font-weight: 700;
			color: #1e293b;
			font-size: 0.75rem;
		}
		.dosha-description {
			font-size: 0.7rem;
			color: #475569;
			line-height: 1.25;
		}
		.no-data {
			text-align: center;
			padding: 3rem;
			color: #636e72;
		}
		.btn-group {
			margin: 2rem 0;
			display: flex;
			gap: 1rem;
			flex-wrap: wrap;
		}
		.btn-sm {
			padding: 0.5rem 1rem;
			font-size: 0.9rem;
		}
	</style>

	<h1>Your moonine Dashboard</h1>

	<div id="loading" class="loading-container">
		<div class="loader"></div>
		<p>Syncing with the stars and calculating cosmic alignments...</p>
	</div>

	<div id="dashboard-content" style="display: none;">
		<div class="section-title">Profile & Panchang</div>
		<div class="dashboard-grid" id="profile-panchang">
			<!-- Injected here -->
		</div>

		<div class="section-title">Planetary Positions</div>
		<div style="overflow-x: auto; margin-bottom: 2rem;">
			<table class="compact-table" id="planets-table">
				<thead>
					<tr>
						<th>Planet</th>
						<th>Rasi</th>
						<th>Degree</th>
						<th>House</th>
					</tr>
				</thead>
				<tbody>
					<!-- Injected here -->
				</tbody>
			</table>
		</div>

		<div class="section-title">Your Top moonine Matches</div>
		<div id="matches-list">
			<!-- Matches injected here -->
		</div>

		<div id="nearest-section" style="display: none;">
			<div class="section-title">Top 10 Nearest People</div>
			<div id="nearest-list">
				<!-- Nearest matches injected here -->
			</div>
		</div>

		<div class="btn-group">
			<a href="/edit-profile" class="btn btn-sm">Edit My Profile</a>
			<button id="resetProfileBtn" class="btn btn-sm btn-danger">Reset My Profile</button>
		</div>
	</div>

	<div id="no-profile" style="display: none;" class="no-data">
		<p>We couldn't find your moonine profile. Please share your birth details to get started!</p>
		<a href="/" class="btn">Create Profile</a>
	</div>

	<div id="error-state" style="display: none;" class="no-data">
		<p style="color: #dc3545; font-weight: bold;">Error connecting to the stars.</p>
		<p>We encountered a problem while fetching moonine data. Please try again later.</p>
	</div>

	<script>
		import { getOrSetUserId, clearUserData, getCookie } from '../lib/user';
		import { fetchUsers, saveUserProfile, resetUserProfile, type UserProfile } from '../lib/api';
		import { calculateAstrology } from '../lib/astrology';
		import { calculateCompatibility } from '../lib/compatibility';
		import { KOOTA_INFO } from '../lib/constants';
		import { generateMatchCardHtml } from '../lib/ui';

		// Haversine distance formula in kilometers
		function getDistanceFromLatLonInKm(lat1: number, lon1: number, lat2: number, lon2: number) {
			const R = 6371; // Radius of the earth in km
			const dLat = deg2rad(lat2 - lat1);
			const dLon = deg2rad(lon2 - lon1);
			const a =
				Math.sin(dLat / 2) * Math.sin(dLat / 2) +
				Math.cos(deg2rad(lat1)) * Math.cos(deg2rad(lat2)) *
				Math.sin(dLon / 2) * Math.sin(dLon / 2);
			const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
			const d = R * c; // Distance in km
			return d;
		}

		function deg2rad(deg: number) {
			return deg * (Math.PI / 180);
		}

		window.addEventListener('load', async () => {
			const uid = getOrSetUserId();
			const stored = getCookie('user_details');

			if (!stored) {
				document.getElementById('loading')!.style.display = 'none';
				document.getElementById('no-profile')!.style.display = 'block';
				return;
			}

			const details = JSON.parse(stored);
			const resetBtn = document.getElementById('resetProfileBtn') as HTMLButtonElement;

			function formatTime12h(t24: string): string {
				if (!t24) return "";
				const [h24, m] = t24.split(':');
				let h = parseInt(h24);
				const ampm = h >= 12 ? 'PM' : 'AM';
				h = h % 12;
				if (h === 0) h = 12;
				return `${h.toString().padStart(2, '0')}:${m} ${ampm}`;
			}

			resetBtn?.addEventListener('click', async () => {
				if (confirm('Are you sure you want to reset your moonine profile? Please note that we do not keep your data after a reset. It will be permanently deleted from our systems as well as your local device.')) {
					if (uid) await resetUserProfile(uid);
					clearUserData();
					window.location.href = '/';
				}
			});

			try {
				const users = await fetchUsers();
				let profile = users.find(u => u.uid === uid);

				const lat = details.lat ? parseFloat(details.lat) : 28.6139;
				const lon = details.lon ? parseFloat(details.lon) : 77.2090;
				const astroData = calculateAstrology(details.dob, details.tob, lat, lon);

				// Determine if we need to update the backend
				const otherUsersCount = users.filter(u => u.uid !== uid && u.name).length;
				const hasMatches = profile && profile.matches && profile.matches.length > 0;

				// We should update if:
				// 1. Profile is missing from backend
				// 2. Matches are missing but there are other users to match with
				// 3. Local details differ from backend details (e.g. name, dob changed)

				let needsUpdate = !profile;

				if (profile) {
					const detailsChanged =
						profile.name !== details.name ||
						profile.dob !== details.dob ||
						profile.tob !== details.tob ||
						profile.location !== details.location ||
						profile.currentLocation !== details.currentLocation ||
						profile.currentLat !== details.currentLat ||
						profile.currentLon !== details.currentLon;

					const matchesMissing = !hasMatches && otherUsersCount > 0;

					// Check if nearest is missing but user has location set
					const nearestMissing = (!profile.nearest || profile.nearest.length === 0) && (details.currentLat && details.currentLon) && otherUsersCount > 0;

					if (detailsChanged || matchesMissing || nearestMissing) {
						needsUpdate = true;
					}
				}

				if (needsUpdate) {
					console.log('Updating profile and matches on backend...');
					const otherUsers = users.filter(u => u.uid !== uid && u.name && u.dob && u.tob);
					const currentUserAstrology = {
						name: details.name,
						nakshatraIdx: astroData.panchang.nakshatraIdx,
						moonSignIdx: astroData.panchang.moonSignIdx,
						isMoonManglik: astroData.panchang.isMoonManglik,
						isLaganManglik: astroData.panchang.isLaganManglik,
						gender: details.gender
					};

					// Determine if user has a current location for "nearest" feature
					const hasCurrentLocation = details.currentLat && details.currentLon;
					const myLat = hasCurrentLocation ? parseFloat(details.currentLat) : undefined;
					const myLon = hasCurrentLocation ? parseFloat(details.currentLon) : undefined;

					const resultsWithScores = otherUsers.map(user => {
						let uNakIdx = user.nakshatraIdx;
						let uMoonSignIdx = user.moonSignIdx;
						let uIsMoonManglik = user.isMoonManglik;
						let uIsLaganManglik = user.isLaganManglik;

						if ((uNakIdx === undefined || uMoonSignIdx === undefined || uIsMoonManglik === undefined) && user.dob && user.tob) {
							try {
								const uLat = user.lat ? parseFloat(user.lat) : 28.6139;
								const uLon = user.lon ? parseFloat(user.lon) : 77.2090;
								const uData = calculateAstrology(user.dob, user.tob, uLat, uLon);
								uNakIdx = uData.panchang.nakshatraIdx;
								uMoonSignIdx = uData.panchang.moonSignIdx;
								uIsMoonManglik = uData.panchang.isMoonManglik;
								uIsLaganManglik = uData.panchang.isLaganManglik;
							} catch (e) {
								console.warn(`Failed to calculate astrology for user ${user.uid}`, e);
							}
						}

						const compat = calculateCompatibility(currentUserAstrology, {
							name: user.name,
							nakshatraIdx: uNakIdx!,
							moonSignIdx: uMoonSignIdx!,
							isMoonManglik: uIsMoonManglik,
							isLaganManglik: uIsLaganManglik,
							gender: user.gender
						});

						// Calculate distance if both users have locations
						let distance = undefined;
						if (hasCurrentLocation) {
							// Use target user's current location, fallback to birth location
							let tLat = user.currentLat ? parseFloat(user.currentLat) : (user.lat ? parseFloat(user.lat) : undefined);
							let tLon = user.currentLon ? parseFloat(user.currentLon) : (user.lon ? parseFloat(user.lon) : undefined);
							if (tLat !== undefined && tLon !== undefined && myLat !== undefined && myLon !== undefined) {
								distance = getDistanceFromLatLonInKm(myLat, myLon, tLat, tLon);
							}
						}

						return { user, compat, distance };
					});

					resultsWithScores.sort((a, b) => b.compat.score - a.compat.score);
					const top10 = resultsWithScores.slice(0, 10);

					let top10Nearest: any[] = [];
					if (hasCurrentLocation) {
						const withDistance = resultsWithScores.filter(r => r.distance !== undefined);
						withDistance.sort((a, b) => a.distance! - b.distance!);
						top10Nearest = withDistance.slice(0, 10);
					}

					const updatedProfile: UserProfile = {
						...details,
						uid: uid,
						nakshatraIdx: astroData.panchang.nakshatraIdx,
						moonSignIdx: astroData.panchang.moonSignIdx,
						isMoonManglik: astroData.panchang.isMoonManglik,
						isLaganManglik: astroData.panchang.isLaganManglik,
						matches: top10.map(m => ({
							uid: m.user.uid,
							name: m.user.name,
							score: m.compat.score,
							category: m.compat.category,
							description: m.compat.description,
							maxScore: m.compat.maxScore,
							kootas: m.compat.kootas,
							doshas: m.compat.doshas
						})),
						nearest: top10Nearest.map(m => ({
							uid: m.user.uid,
							name: m.user.name,
							score: m.compat.score,
							category: m.compat.category,
							description: m.compat.description,
							distance: m.distance,
							maxScore: m.compat.maxScore,
							kootas: m.compat.kootas,
							doshas: m.compat.doshas
						}))
					};

					// Use a session flag to avoid multiple saves in one session if something loops
					if (!window.sessionStorage.getItem('profile_saved_' + uid)) {
						await saveUserProfile(updatedProfile);
						window.sessionStorage.setItem('profile_saved_' + uid, 'true');
					}
					profile = updatedProfile;
				}

				// Rendering
				document.getElementById('loading')!.style.display = 'none';
				document.getElementById('dashboard-content')!.style.display = 'block';

				const infoGrid = document.getElementById('profile-panchang')!;
				const items = [
					{ label: 'User ID', value: profile.uid },
					{ label: 'Name', value: profile.name },
					{ label: 'Born', value: `${profile.dob} ${formatTime12h(profile.tob)}` },
					{ label: 'Location', value: profile.location },
					{ label: 'Nakshatra', value: astroData.panchang.nakshatra },
					{ label: 'Moon Sign', value: astroData.panchang.moonSign },
					{ label: 'Day (Vara)', value: `${astroData.panchang.vara} (${astroData.panchang.varaLord})` },
					{ label: 'Tithi', value: astroData.panchang.tithi },
					{ label: 'Lagan Manglik', value: profile.isLaganManglik ? 'Yes' : 'No' }
				];

				infoGrid.innerHTML = items.map(i => `
					<div class="info-card">
						<div class="info-item">
							<span class="info-label">${i.label}</span>
							<span class="info-value">${i.value}</span>
						</div>
					</div>
				`).join('');

				const tbody = document.querySelector('#planets-table tbody')!;
				tbody.innerHTML = ''; // clear before appending
				astroData.planets.forEach(p => {
					const tr = document.createElement('tr');
					tr.innerHTML = `
						<td>${p.name}</td>
						<td>${p.rasi}</td>
						<td>${p.degree}</td>
						<td>${p.house}</td>
					`;
					tbody.appendChild(tr);
				});

				const matchesList = document.getElementById('matches-list')!;
				matchesList.innerHTML = '';

				function renderMatches(listContainer: HTMLElement, matchesData: any[], showDistance: boolean = false) {
					if (matchesData && matchesData.length > 0) {
						matchesData.forEach((m: any) => {
							const otherUser = users.find(u => u.uid === m.uid);
							let kootaHtml = '';
							let age: number | undefined = undefined;

							if (otherUser) {
								const uDob = typeof otherUser.dob === 'string' && otherUser.dob.includes('T') ? otherUser.dob.split('T')[0] : otherUser.dob;
								if (uDob) {
									const dobDate = new Date(uDob);
									const today = new Date();
									age = today.getFullYear() - dobDate.getFullYear();
									const m = today.getMonth() - dobDate.getMonth();
									if (m < 0 || (m === 0 && today.getDate() < dobDate.getDate())) {
										age--;
									}
								}
								let compat = {
									kootas: m.kootas || [],
									doshas: m.doshas || [],
									description: m.description || '',
									score: m.score || 0,
									maxScore: m.maxScore || 36
								};

								// Fallback if kootas weren't saved in the backend
								if (!m.kootas || m.kootas.length === 0) {
									const uLat = otherUser.lat ? parseFloat(otherUser.lat) : 28.6139;
									const uLon = otherUser.lon ? parseFloat(otherUser.lon) : 77.2090;

									// Ensure dob and tob are in correct format if they came back as ISO strings or something else from backend
									const uTob = typeof otherUser.tob === 'string' && otherUser.tob.includes('T') ? otherUser.tob.split('T')[1].substring(0, 5) : otherUser.tob;

									const uData = calculateAstrology(uDob, uTob, uLat, uLon);

									// Prioritize pre-calculated indices from profile for consistency
									compat = calculateCompatibility(
										{
											name: profile.name,
											nakshatraIdx: profile.nakshatraIdx ?? astroData.panchang.nakshatraIdx,
											moonSignIdx: profile.moonSignIdx ?? astroData.panchang.moonSignIdx,
											isMoonManglik: profile.isMoonManglik ?? astroData.panchang.isMoonManglik,
											isLaganManglik: profile.isLaganManglik ?? astroData.panchang.isLaganManglik,
											gender: profile.gender
										},
										{
											name: otherUser.name,
											nakshatraIdx: otherUser.nakshatraIdx ?? uData.panchang.nakshatraIdx,
											moonSignIdx: otherUser.moonSignIdx ?? uData.panchang.moonSignIdx,
											isMoonManglik: otherUser.isMoonManglik ?? uData.panchang.isMoonManglik,
											isLaganManglik: otherUser.isLaganManglik ?? uData.panchang.isLaganManglik,
											gender: otherUser.gender
										}
									);
								}

								kootaHtml = `
									<div style="overflow-x: auto; margin-top: 0.5rem;">
										<table class="compact-table" style="font-size: 0.65rem;">
											<thead>
												<tr>
													<th>#</th>
													<th>Guna</th>
													<th>Girl</th>
													<th>Boy</th>
													<th>Obtained</th>
													<th>Max</th>
													<th>Area of Life</th>
												</tr>
											</thead>
											<tbody>
												${compat.kootas.map((k: any, idx: number) => `
													<tr>
														<td>${idx + 1}</td>
														<td>${k.name}</td>
														<td>${k.girlValue}</td>
														<td>${k.boyValue}</td>
														<td>${k.score}</td>
														<td>${k.max}</td>
														<td>${k.areaOfLife}</td>
													</tr>
												`).join('')}
											</tbody>
											<tfoot>
												<tr style="background: #f8fafc; font-weight: 800;">
													<td colspan="4" style="text-align: right;">Total Guna Milan Points</td>
													<td>${compat.score}</td>
													<td>${compat.maxScore}</td>
													<td></td>
												</tr>
											</tfoot>
										</table>
									</div>
								`;

								const distanceHtml = showDistance && m.distance !== undefined ?
									`<div style="font-size: 0.8rem; color: #64748b; margin-top: 0.5rem; font-weight: 600;">📍 Approx. ${Math.round(m.distance)} km away</div>` : '';

								const card = document.createElement('div');
								card.className = 'match-card';
								card.innerHTML = distanceHtml + generateMatchCardHtml(m.uid, m.name, age, m.category, m.score, compat.description, kootaHtml, compat.doshas);
								listContainer.appendChild(card);
							}
						});
					} else {
						listContainer.innerHTML = '<p>No matches found yet. They will appear here as more people join!</p>';
					}
				}

				if (profile.matches) {
					renderMatches(matchesList, profile.matches);
				} else {
					matchesList.innerHTML = '<p>No matches found yet. They will appear here as more people join!</p>';
				}

				const nearestSection = document.getElementById('nearest-section')!;
				const nearestList = document.getElementById('nearest-list')!;
				nearestList.innerHTML = '';

				if (profile.currentLat && profile.currentLon) {
					nearestSection.style.display = 'block';
					if (profile.nearest) {
						renderMatches(nearestList, profile.nearest, true);
					} else {
						nearestList.innerHTML = '<p>No people found nearby yet.</p>';
					}
				} else {
					nearestSection.style.display = 'none';
				}


			} catch (error) {
				console.error("Dashboard error:", error);
				document.getElementById('loading')!.style.display = 'none';
				document.getElementById('error-state')!.style.display = 'block';
			}
		});
	</script>
</Layout>
